---
import { parseUrl } from '@app/utils/navigation';
import {
  crumbDictionary,
  defaultBreadcrumbs,
} from '@app/localization/breadcrumbs';
import { gameNames } from '@app/localization/game-names';
import { undefined } from 'astro:schema';

interface Breadcrumb {
  label: string;
  url: string;
}

interface Props {
  title?: string; // can be set to undefined to turn off breadcrumbs
  specificBreadcrumbs?: Breadcrumb[];
}

const { title, specificBreadcrumbs } = Astro.props;

const url = Astro.url.pathname;
const parts = url.split('/').filter(Boolean);
const isBlog = (parts[0] ?? '') === 'blog';
const { lang, gameId } = parseUrl(url);

function getBreadcrumbs() {
  const gameCrumb: Breadcrumb[] = [];

  if (gameId !== 'default') {
    let langCode = defaultBreadcrumbs[gameId][1] ? `/${lang}` : '';
    gameCrumb.push({
      label: (gameNames as any)[gameId][lang],
      url: `/${gameId}/${defaultBreadcrumbs[gameId][0]}${langCode}`,
    });
  } else if (!isBlog) return [];

  let baseUrl = `/${gameId}`;

  for (let i = 1; i < parts.length - 1; i++) {
    baseUrl = `${baseUrl}/${parts[i]}`;
    let label = crumbDictionary[parts[i]]?.[lang];
    if (label) gameCrumb.push({ label, url: `${baseUrl}/${lang}` });
  }
  return gameCrumb;
}

if (!isBlog && !defaultBreadcrumbs[gameId]) return;

const crumbs: Breadcrumb[] =
  specificBreadcrumbs ??
  getBreadcrumbs().filter((f) => f.label !== '' && f.label !== title);
if (!isBlog && gameId === 'default') return;
const current = title || crumbs[crumbs.length - 1].label;
---

{
  (title || isBlog) && (
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb">
        <li class="breadcrumb-item">
          <a href="/">Home</a>
        </li>
        {crumbs.map((crumb) => (
          <li class="breadcrumb-item">
            <a href={crumb.url}>{crumb.label}</a>
          </li>
        ))}
        <li class="breadcrumb-item active" aria-current="page">
          {current}
        </li>
      </ol>
    </nav>
  )
}

<style>
  .breadcrumb {
    display: flex;
    list-style: none;
    padding: 0;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .breadcrumb-item {
    word-wrap: anywhere;
  }
  .breadcrumb-item + .breadcrumb-item::before {
    content: '/';
    margin-right: 0.5rem;
  }
  .active {
    color: gray;
  }
</style>
