---
import type { NavItem } from '@app/localization/localization';
import { getNavForGame } from '@app/utils/navigation';
const pathSegments = Astro.url.pathname.split('/');

const navItems = await getNavForGame(Astro.url.pathname);
const globalItems = await getNavForGame('global');
---

<aside class="sidebar" id="sidebar">
  <nav>
    {
      navItems.map((n: NavItem) => {
        const isExpandable = !!n.children;
        const Tag = isExpandable ? 'button' : 'a';

        const props = {
          class: isExpandable ? 'sidebar-item expand-toggle' : 'sidebar-item',
          href: !isExpandable ? n.url : undefined,
          'aria-expanded': isExpandable
            ? n.expand
              ? 'true'
              : 'false'
            : undefined,
        };

        return (
          <div class="nav-group" data-expand={n.expand ? 'true' : 'false'}>
            <Tag {...props}>
              {n.svg ? (
                <svg>
                  <use href={`/media/spritesheets/${n.svg}`} />
                </svg>
                <span>{n.name}</span>
              ) : (
              <span class="sidebar-spacer">{n.name}</span>
              )}
              {isExpandable && (
                <>
                  <svg class="caret-down">
                    <use href="/media/spritesheets/main.svg?v=1#fa-caret-down" />
                  </svg>
                  <svg class="caret-up">
                    <use href="/media/spritesheets/main.svg?v=1#fa-caret-up" />
                  </svg>
                </>
              )}
            </Tag>

            {n.children && (
              <div class="sidebar-children">
                {n.children.map((c) => (
                  <a
                    class={`sidebar-spacer sidebar-item ${Astro.url.pathname.includes(c.url) ? 'active' : ''}`}
                    href={c.url}
                  >
                    {c.name}
                  </a>
                ))}
              </div>
            )}
          </div>
        );
      })
    }
    <div class="nav-global">
      {
        globalItems.map((n: NavItem) => (
          <a
            class="sidebar-item"
            href={n.url}
            target={n.external ? '_blank' : undefined}
            rel={n.external ? 'noopener noreferrer' : undefined}
          >
            {n.svg && (
              <svg>
                <use href={`/media/spritesheets/${n.svg}`} />
              </svg>
            )}
            {n.name}
          </a>
        ))
      }
    </div>
  </nav>
</aside>
<script>
  const sidebar = document.getElementById('sidebar');
  const wrapper = document.getElementsByClassName('layout-wrapper')[0];
  const toggleBtn = document.getElementById('hamburger');

  toggleBtn?.addEventListener('click', () => {
    sidebar?.classList.toggle('hidden');
    wrapper?.classList.toggle('sidebar-hidden');
  });

  document.querySelectorAll('.expand-toggle').forEach((btn) => {
    btn.addEventListener('click', () => {
      const parent = btn.parentElement;
      const isexpand = parent?.getAttribute('data-expand') === 'true';
      parent?.setAttribute('data-expand', (!isexpand).toString());
      btn.setAttribute('aria-expanded', (!isexpand).toString());
    });
  });
</script>
<style lang="scss">
@use '@styles/variables' as v;

.sidebar {
  background-color: var(--sidebar-color);
  width: var(--sidebar-width);
  font-size: 1rem;
  z-index: 1500;
  transition: transform 0.3s ease-in-out;
  position: fixed;
  height: 100%;
  left: 0;
}

.sidebar.hidden {
  transform: translateX(-100%);
}

@media (max-width: v.$breakpoint-md) {
  .sidebar {
    margin-left: calc(-1 * var(--sidebar-width));
  }

  .sidebar.hidden {
    transform: translateX(100%);
  }
}

.sidebar-items {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.sidebar-item {
  svg:first-child {
      width: 1.5em;
      height: 1.5em;
      margin-right: 0.5rem;
    }
}

.sidebar-item:hover {
  color: white;
  background-color: #20a8d8 !important;
  text-decoration: none;
}

.sidebar-item.active {
  background-color: #3c4e5e;
}

.sidebar-children {
  display: none;
  list-style: none;
  padding: 0;
}

.nav-group[data-expand="true"] .sidebar-children {
  display: block;
}

.nav-group[data-expand="true"] .caret-down { display: none; }
.nav-group[data-expand="false"] .caret-up { display: none; }

.sidebar-spacer {
  padding-left: 2.1rem !important;
}

.expand-toggle {
  appearance: none;
  background: none;
  border: none;
  padding: 0;
  margin: auto;
  cursor: pointer;
  font-family: inherit;
  font-size: inherit;
  font-weight: inherit;
  color: white;
  width: 100%;
  width: -webkit-fill-available;
  width: -moz-available;
  width: stretch;
  text-align: left;
}
.expand-toggle {
  .caret-down, .caret-up {
    width: 1.5em;
    height: 1.5em;
    margin-left: auto;
  }
}

.sidebar-item, .expand-toggle {
  padding: 0.6rem 0.1rem;
  margin-right: 0.4rem;
  margin-left: 0.4rem;
  color: white;
  fill: white;
  border-radius: 0.25rem;
  display: flex;
  align-items: center;
  position: relative;
}

.nav-global {
  margin-top: 1rem;
}

</style>
