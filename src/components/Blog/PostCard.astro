---
import { Image } from 'astro:assets';
import FormattedDate from '@components/MainLayout/FormattedDate.astro';
import { getFolderSlug } from '@app/utils/get-slug';

const { post, index } = Astro.props;
const slug = getFolderSlug(post);
---

<div class="card">
  <a href={`/${slug}`}>
    {
      post.data.heroImage && (
        <img
          src={post.data.heroImage}
          alt=""
          loading={index < 3 ? 'eager' : 'lazy'}
          fetchpriority={index == 0 ? 'high' : 'auto'}
        />
      )
    }
    <h4>{post.data.title}</h4>
  </a>
  <span class="text-muted svg-inline-text">
    <svg><use href="/media/spritesheets/main.svg?v=1#fa-calendar"></use></svg>
    <FormattedDate date={post.data.pubDate} />
  </span>
  <span>{post.data.description}</span>
</div>
