---
const { prevUrl, nextUrl, current, last } = Astro.props;
---

<nav class="pagination">
  {prevUrl ? <a href={prevUrl}>&larr; Previous</a> : <div />}

  {
    current && last ? (
      <span>
        Page {current} of {last}
      </span>
    ) : (
      <div />
    )
  }

  {nextUrl ? <a href={nextUrl}>Next &rarr;</a> : <div />}
</nav>
<style>
  .pagination {
    margin-top: 1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;

    > * {
      flex: 1;
    }

    span {
      text-align: center;
    }

    a:first-child {
      text-align: left;
    }

    a:last-child {
      text-align: right;
    }
  }
</style>
