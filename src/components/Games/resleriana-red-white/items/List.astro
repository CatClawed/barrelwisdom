---
import { getCollection } from 'astro:content';
import ItemAttributeList from './ItemAttributeList.astro';
import PaneListWrapper from '@components/Games/_common/List/PaneListWrapper.astro';
import ItemList from '@components/Games/_common/List/ItemList.astro';
import Dropdown from '@components/Games/_common/Filter/Dropdown.astro';
import FilterButton from '@components/Games/_common/Filter/FilterButton.astro';
import TextFilter from '@components/Games/_common/Filter/TextFilter.astro';
import { category_translation } from '@app/localization/translations/common-strings';
import ColorPicker from './ColorPicker.astro';

const { items, lang, title, game, section } = Astro.props;

const categories = await getCollection(`${game}_categories`);

const categoryOptions = categories.map((cat) => ({
  id: cat.id,
  label: cat.data.name[lang],
  icon: `/spritesheets/${game}.svg?v=1#category-${cat.id}`,
}));

items.sort((a, b) => a.id.localeCompare(b.id, undefined, { numeric: true }));
---

<PaneListWrapper title={title} section={section} game={game} lang={lang}>
  <div class="filters" slot="filters">
    <TextFilter gridSize={10} lang={lang} />
    <ColorPicker lang={lang} />
    <Dropdown
      options={categoryOptions}
      name="category"
      placeholder={category_translation[lang]}
      lang={lang}
    />
    <FilterButton
      svg={`${game}.svg?v=1`}
      name="kind"
      singleOnly={true}
      gridSpan="8"
      list={[
        { filterKey: 'guide-ingredients', icon: 'guide-ingredients' },
        { filterKey: 'category-41', icon: 'category-41' },
        {
          filterKey: 'guide-consumable-color',
          icon: 'guide-consumable-color',
        },
        { filterKey: 'guide-equip', icon: 'guide-equip' },
        { filterKey: 'guide-search-color', icon: 'guide-search-color' },
        { filterKey: 'guide-synthesis-color', icon: 'guide-synthesis-color' },
        { filterKey: 'guide-important-color', icon: 'guide-important-color' },
      ]}
    />
  </div>
  {
    items.map((i, index) => (
      <ItemList
        item={i}
        cls="shrink-text"
        img={`/media/games/${game}/${section}/${i.id}.webp`}
        index={index}
        section={section}
        lang={lang}
        game={game}
        data-id={i.id}
        data-search={i.data.name[lang]}
        data-category={i.data.categories.map((c) => c.id).join(',')}
        data-kind={i.data.icon}
        data-color-r={i.data.colors?.map((c) => c.r).join(',')}
        data-color-l={i.data.colors?.map((c) => c.l).join(',')}
      >
        {i.data.dlc && (
          <span slot="title-matter" class="badge bg-primary">
            DLC
          </span>
        )}
        <svg slot="title-matter" class="medium-icon">
          <use href={`/spritesheets/${game}.svg?v=1#${i.data.icon}`} />
        </svg>
        <ItemAttributeList
          cats={i.data.categories}
          colors={i.data.colors}
          lang={lang}
          game={game}
        />
      </ItemList>
    ))
  }
</PaneListWrapper>
<script>
  import { initListFilters } from '@app/utils/filter-controller';
  import { initPaneController } from '@app/utils/detail-pane-controller';
  initListFilters({
    filters: [
      { type: 'select', key: 'category', elementId: 'category' },
      { type: 'buttons', key: 'kind', groupName: 'kind', mode: 'any' },
      { type: 'color', keyL: 'colorL', keyR: 'colorR' },
    ],
  });
  initPaneController({});
</script>
