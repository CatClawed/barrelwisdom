---
import { getCollection } from 'astro:content';
import PaneListWrapper from '@components/Games/_common/List/PaneListWrapper.astro';
import MonsterList from '@components/Games/_common/List/MonsterList.astro';
import FilterButton from '@components/Games/_common/Filter/FilterButton.astro';
import TextFilter from '@components/Games/_common/Filter/TextFilter.astro';
const { items, lang, title, game, section } = Astro.props;

const races = await getCollection('yumia_races');

items.sort((a, b) => a.id.localeCompare(b.id, undefined, { numeric: true }));
---

<PaneListWrapper
  title={title}
  section={section}
  game={game}
  lang={lang}
  placeholder="puni"
>
  <div class="filters" slot="filters">
    <TextFilter gridSize={8} lang={lang} />
    <FilterButton
      svg={`${game}.svg?v=1`}
      name="kinds"
      gridSpan="4"
      singleOnly={true}
      list={[
        { filterKey: 'small', icon: 'enemy-small' },
        { filterKey: 'large', icon: 'enemy-large' },
        { filterKey: 'boss', icon: 'enemy-boss' },
      ]}
    />
  </div>
  {
    items.map((i, index) => (
      <MonsterList
        item={i}
        img={`/media/games/${game}/${section}/${i.id}.webp`}
        game={game}
        section={section}
        lang={lang}
        index={index}
        data-id={i.id}
        data-search={i.data.name[lang]}
        data-ind={i.index}
        data-kinds={
          i.data.index < 500 ? 'small' : i.data.index < 1000 ? 'large' : 'boss'
        }
      >
        {i.data.dlc && <span class="badge bg-primary">DLC</span>}
      </MonsterList>
    ))
  }
</PaneListWrapper>
<script>
  import { initListFilters } from '@app/utils/filter-controller';
  import { initPaneController } from '@app/utils/detail-pane-controller';
  initListFilters({
    filters: [
      { type: 'buttons', key: 'kinds', groupName: 'kinds', mode: 'any' },
    ],
  });
  initPaneController({});
</script>
<style>
  .search-container {
    position: relative;
    display: flex;
    align-items: center;
    input {
      width: 100%;
    }
  }
  .shortcut-hint {
    position: absolute;
    right: 10px;
    padding: 2px 6px;
    border: 1px solid #ccc;
    border-radius: 4px;
    font-size: 0.8rem;
    pointer-events: none; /* Ensure clicks pass through to the input */
  }
</style>
