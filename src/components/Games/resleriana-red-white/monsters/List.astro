---
import { getCollection } from 'astro:content';
import FilterButton from '@components/Games/_common/FilterButton.astro';
import TextFilter from '@components/Games/_common/TextFilter.astro';
const { items, lang, title, game, section } = Astro.props;

const races = await getCollection('yumia_races');

items.sort((a, b) => a.id.localeCompare(b.id, undefined, { numeric: true }));
---

<h1>{title}</h1>
<div class="master-detail">
  <div>
    <div class="filters">
      <TextFilter gridSize={8} lang={lang} />
      <FilterButton
        svg={`${game}.svg?v=1`}
        name="kinds"
        gridSpan="4"
        singleOnly={true}
        list={[
          { filterKey: 'small', icon: 'enemy-small' },
          { filterKey: 'large', icon: 'enemy-large' },
          { filterKey: 'boss', icon: 'enemy-boss' },
        ]}
      />
    </div>
    <ul
      class="list"
      id="item-list"
      data-lang={lang}
      data-game={game}
      data-section={section}
    >
      {
        items.map((i, index) => (
          <li
            class="list-container"
            data-id={i.id}
            data-search={i.data.name[lang]}
            data-ind={i.index}
            data-kinds={
              i.data.index < 500
                ? 'small'
                : i.data.index < 1000
                  ? 'large'
                  : 'boss'
            }
          >
            <img
              class="item-image-display"
              src={`/media/games/${game}/monsters/${i.id}.webp`}
              alt={i.data.name[lang]}
              loading={index < 25 ? 'eager' : 'lazy'}
            />
            <div class="card monster-display card-title">
              <a href={`/${game}/monsters/${i.id}/${lang}`}>
                <h3 class="item-trigger">{i.data.name[lang]}</h3>
              </a>
              {i.data.dlc && <span class="badge bg-primary">DLC</span>}
            </div>
          </li>
        ))
      }
    </ul>
  </div>

  <div id="detail-pane" class="detail-pane">
    <svg class="placeholder-icon blue-placeholder">
      <use href={`/spritesheets/yumia.svg#puni`}></use>
    </svg>
  </div>
</div>
<script>
  import { initListFilters } from '@app/utils/filter-controller';
  import { initPaneController } from '@app/utils/detail-pane-controller';
  initListFilters({
    filters: [
      { type: 'buttons', key: 'kinds', groupName: 'kinds', mode: 'any' },
    ],
  });
  initPaneController({});
</script>
<style>
  .search-container {
    position: relative;
    display: flex;
    align-items: center;
    input {
      width: 100%;
    }
  }
  .shortcut-hint {
    position: absolute;
    right: 10px;
    padding: 2px 6px;
    border: 1px solid #ccc;
    border-radius: 4px;
    font-size: 0.8rem;
    pointer-events: none; /* Ensure clicks pass through to the input */
  }
</style>
