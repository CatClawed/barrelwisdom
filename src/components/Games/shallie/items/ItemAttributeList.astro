---
import { itemElements } from '@app/components/Games/escha/escha_constants';
import SlotIcons from '@app/components/Games/shallie/items/SlotIcons.astro';

const { cats, lang, game, evalue, slots, fire, water, wind, earth, mode = 'list' } = Astro.props;
const activeElements = { fire, water, wind, earth };
---

<div class="item-attributes">
  <ul class="categories">
    {cats?.map((category: any) => (
      <li class="neat-item-display">
        <svg class="medium-icon">
          <use href={`/spritesheets/${game}.svg?v=1#${category.icon}`} />
        </svg>
        {mode === 'detail' ? (
          <a href={`/${game}/categories/${category.id}/${lang}`}>
            {category.name[lang]}
          </a>
        ) : (
          category.name[lang]
        )}
      </li>
    ))}
  </ul>
  <div class="attributes">
    <div>
      {itemElements.map((element) => activeElements[element.id] && (
        <svg
          class="dusk-elements"
          style={`background-color:${element.color};`}
          aria-label={element.id}
        >
          <use href={`/spritesheets/${game}.svg?v=1#element-${element.id}`} />
        </svg>
      ))}
      {evalue !== undefined && <span class="evalue">{evalue}</span>}
    </div>
    <SlotIcons count={slots} game={game} />
  </div>
</div>

<style>
  .item-attributes {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }
  .categories {
    padding-left: 0;
    margin: 0;
  }
  .attributes {
    break-inside: avoid;
  }
  .evalue {
    padding-left: 0.2em;
  }
</style>
