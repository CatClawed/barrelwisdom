---
import { getCollection } from 'astro:content';
import ItemAttributeList from './ItemAttributeList.astro';
import Badge from '@components/Games/_common/Badge.astro';
import PaneListWrapper from '@components/Games/_common/List/PaneListWrapper.astro';
import ItemList from '@components/Games/_common/List/ItemList.astro';
import Dropdown from '@components/Games/_common/Filter/Dropdown.astro';
import FilterButton from '@components/Games/_common/Filter/FilterButton.astro';
import TextFilter from '@components/Games/_common/Filter/TextFilter.astro';
import { category_translation } from '@app/localization/translations/common-strings';

const { items, lang, title, game, section } = Astro.props;

const categories = await getCollection(`${game}_categories`);

const categoryOptions = categories.map((cat) => ({
  id: cat.id,
  label: cat.data.name[lang],
  icon: `/spritesheets/${game}.svg?v=1#category-${cat.id}`,
}));

const filterButtons = [
  { filterKey: 'attack', icon: 'type-attack' },
  { filterKey: 'heal', icon: 'type-heal' },
  { filterKey: 'debuffer', icon: 'type-debuff' },
  { filterKey: 'buffer', icon: 'type-buff' },
  { filterKey: 'weapon', icon: 'type-weapon' },
  { filterKey: 'armor', icon: 'type-armor' },
  { filterKey: 'accessory', icon: 'type-accessory' },
  { filterKey: 'amulet', icon: 'category-talismans' },
  { filterKey: 'field', icon: 'type-exploration' },
  { filterKey: 'mix', icon: 'type-synthesis' },
  { filterKey: 'material', icon: 'ryza2-material', diffsvg: 'main.svg?v=1' },
  { filterKey: 'important', icon: 'category-key-items' },
];

items.sort((a, b) => (a.data.index ?? 0) - (b.data.index ?? 0));
---

<PaneListWrapper title={title} section={section} game={game} lang={lang}>
  <div class="filters" slot="filters">
    <TextFilter gridSize={8} lang={lang} />
    <Dropdown
      options={categoryOptions}
      name="category"
      placeholder={category_translation[lang]}
      lang={lang}
    />
    <FilterButton
      svg={`${game}.svg?v=1`}
      name="kind"
      singleOnly={true}
      gridSpan="12"
      list={filterButtons}
    />
  </div>
  {items.map((i, index) => {
    const item = i.data;
    const allCats = [
      ...(item.categories ?? []).map((c: any) => ({ ...c, add: false })),
      ...(item.add ?? []).map((c: any) => ({ ...c, add: true })),
    ];

    const activeFilters = [
      item.kind,
      item.isMaterial ? 'material' : null,
      item.isKeyItem ? 'key_item' : null,
    ]
      .filter(Boolean)
      .join(',');

    const kindMatch = filterButtons.find((btn) => btn.filterKey === item.kind);
    const spritesheet = kindMatch?.diffsvg || `${game}.svg?v=1`;
    const iconName = kindMatch?.icon;

    return (
      <ItemList
        item={i}
        img={`/media/games/${game}/${section}/${i.id}.webp`}
        index={index}
        section={section}
        lang={lang}
        game={game}
        data-id={i.id}
        data-search={item.name[lang]}
        data-category={allCats.map((c) => c.id).join(',')}
        data-kind={activeFilters}
      >
        {item.isDLC && <Badge slot="title-matter" text="DLC" />}
        {iconName && (
          <svg slot="title-matter" class="medium-icon">
            <use href={`/spritesheets/${spritesheet}#${iconName}`} />
          </svg>
        )}
        <ItemAttributeList cats={allCats} lang={lang} game={game} />
      </ItemList>
    );
  })}
</PaneListWrapper>
<script>
  import { initListFilters } from '@app/utils/filter-controller';
  import { initPaneController } from '@app/utils/detail-pane-controller';
  initListFilters({
    filters: [
      { type: 'select', key: 'category', elementId: 'category' },
      { type: 'buttons', key: 'kind', groupName: 'kind' },
    ],
  });
  initPaneController();
</script>
