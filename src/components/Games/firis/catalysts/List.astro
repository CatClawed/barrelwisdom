---
import { getCollection } from 'astro:content';
import ItemAttributeList from '@components/Games/firis/items/ItemAttributeList.astro';
import PaneListWrapper from '@components/Games/_common/List/PaneListWrapper.astro';
import ItemList from '@components/Games/_common/List/ItemList.astro';
import TextFilter from '@components/Games/_common/Filter/TextFilter.astro';
import { category_translation } from '@app/localization/translations/common-strings';

const { items, lang, title, game, section } = Astro.props;

const final = items
  .filter((i) => i.data.catalyst !== undefined)
  .sort((a, b) => a.data.index - b.data.index);
---

<PaneListWrapper title={title} section={section} game={game} lang={lang}>
  <div class="filters" slot="filters">
    <TextFilter gridSize={12} lang={lang} />
  </div>
  {
    final.map((i, index) => (
      <ItemList
        item={i}
        img={`/media/games/${game}/items/${i.id}.webp`}
        index={index}
        section="items"
        lang={lang}
        game={game}
        data-id={i.id}
        data-search={`${i.data.name[lang].toLowerCase()}
            ${i.data.categories
              .map((c) => c.name[lang].toLowerCase())
              .join(' ')}
            ${i.data.catalyst.action[lang].map((a) => a.toLowerCase()).join(' ')}
          `}
      >
        <span slot="title-matter">
          {i.data.catalyst.size} x {i.data.catalyst.size}
        </span>
        <ItemAttributeList
          cats={i.data.categories}
          catalyst={i.data.catalyst}
          lang={lang}
          game={game}
        />
      </ItemList>
    ))
  }
</PaneListWrapper>
<script>
  import { initListFilters } from '@app/utils/filter-controller';
  import { initPaneController } from '@app/utils/detail-pane-controller';
  initListFilters({});
  initPaneController({});
</script>
