---
import { effect_singular_translation } from '@app/localization/translations/common-strings';
import Badge from '@components/Games/_common/Badge.astro';

const { item, lang, game } = Astro.props;
---

<tr>
  <td>
    <a href={`/${game}/items/${item.id}/${lang}`}>{item.name[lang]}</a>
    {item.add && ` (${effect_singular_translation[lang]})`}
    {item.isDLC && <Badge text="DLC" />}
    {item.isDX && <Badge text="DX" />}
  </td>
</tr>
