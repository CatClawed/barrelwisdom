---
import {
  level_translation,
  trait_translation,
} from '@app/localization/translations/common-strings';

const { items, lang, title, game, section } = Astro.props;
---

<h1>{title}</h1>
<div class="table-of-contents">
  <ol>
    {
      items.map((shop) => (
        <li>
          <a href={`/${game}/${section}/${lang}#${shop.data.id}`}>
            {shop.data.name[lang]}
          </a>
        </li>
      ))
    }
  </ol>
</div>

{
  items.map((shop) => (
    <div class="card" style="max-width: 1000px; margin-top: 2em;">
      <h4 class="card-title" id={shop.data.id}>
        {shop.data.name[lang]}
      </h4>
      <ul class="two-column-list">
        {shop.data.shopslots.map((slot) => (
          <li>
            <a href={`/${game}/items/${slot.item.id}/${lang}`}>
              {slot.item.name[lang]}
            </a>
          </li>
        ))}
      </ul>
    </div>
  ))
}
