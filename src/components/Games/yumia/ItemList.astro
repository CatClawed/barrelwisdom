---
import { getCollection } from 'astro:content';
import ItemAttributeList from './ItemAttributeList.astro';
import Dropdown from '@components/Games/_common/Dropdown.astro';
import FilterButton from '@components/Games/_common/FilterButton.astro';
import { category_to_icon, element_map } from './yumia_constants';
import {
  category_translation,
  filter_translation,
} from '@app/localization/translations/common-strings';
import { material_translation } from '@app/localization/translations/yumia';

const { items, lang } = Astro.props;

const categories = await getCollection('yumia_categories');
const materials = await getCollection('yumia_materials');

const categoryOptions = categories.map((cat) => ({
  id: cat.id,
  label: cat.data.name[lang],
  icon: `/spritesheets/A26.svg?v=1#${category_to_icon[cat.id]}`,
}));

const materialOptions = materials.map((o) => ({
  id: o.id,
  label: o.data.name[lang],
  icon: `/spritesheets/A26.svg?v=1#material-${o.id}`,
}));

items.sort((a, b) => a.id.localeCompare(b.id, undefined, { numeric: true }));
---

<div class="master-detail">
  <div>
    <div class="filters">
      <input
        type="text"
        id="filter"
        placeholder={filter_translation[lang]}
        autocomplete="off"
        class="grid-12"
      />
      <Dropdown
        options={categoryOptions}
        name="category"
        placeholder={category_translation[lang]}
      />
      <Dropdown
        options={materialOptions}
        name="material"
        placeholder={material_translation[lang]}
      />
      <FilterButton
        svg="A26.svg?v=1"
        extraClass="a26-elements2"
        name="elements"
        list={[
          { filterKey: 'fire', icon: 'fire', activeColor: element_map.fire },
          { filterKey: 'ice', icon: 'ice', activeColor: element_map.ice },
          { filterKey: 'bolt', icon: 'bolt', activeColor: element_map.bolt },
          { filterKey: 'air', icon: 'air', activeColor: element_map.air },
        ]}
      />
      <FilterButton
        svg="A26.svg?v=1"
        name="kind"
        singleOnly={true}
        list={[
          { filterKey: 'gather', icon: 'items' },
          { filterKey: 'consumable', icon: 'category-bombs' },
          { filterKey: 'synth', icon: 'synth' },
          { filterKey: 'equip', icon: 'equip' },
          { filterKey: 'explore', icon: 'exploration' },
          { filterKey: 'key', icon: 'category-key-items' },
          { filterKey: 'furniture', icon: 'category-interior' },
        ]}
      />
    </div>
    <ul class="list" id="item-list">
      {
        items.map((i, index) => (
          <li
            class="list-container"
            data-id={i.id}
            data-category={i.data.cats.map((c) => c.id).join(',')}
            data-material={i.data.mats?.map((c) => c.id).join(',')}
            data-elements={[
              i.data.fire && 'fire',
              i.data.ice && 'ice',
              i.data.bolt && 'bolt',
              i.data.air && 'air',
            ]
              .filter(Boolean)
              .join(',')}
            data-kind={i.data.kind}
          >
            {i.data.cats[0].id != 38 && (
              <img
                class="item-image-display"
                src={`/media/games/yumia/items/${i.id}.webp`}
                alt={i.data.name[lang]}
                loading={index < 25 ? 'eager' : 'lazy'}
              />
            )}
            <div class="card">
              <a class="card-title" href={`/yumia/items/${i.id}/${lang}`}>
                <h4 class="item-trigger">{i.data.name[lang]}</h4>
                {i.data.isDLC && <span class="badge bg-primary">DLC</span>}
              </a>
              <ItemAttributeList
                cats={i.data.cats}
                mats={i.data.mats}
                resonance={i.data.resonance}
                fire={i.data.fire}
                ice={i.data.ice}
                bolt={i.data.bolt}
                air={i.data.air}
                lang={lang}
              />
            </div>
          </li>
        ))
      }
    </ul>
  </div>

  <div id="detail-pane" class="detail-pane">
    <svg class="placeholder-icon">
      <use href="/spritesheets/main.svg#flask"></use>
    </svg>
  </div>
</div>
<script>
  import { initSearchableSelects } from '@components/Games/_common/dropdown_client';
  import { initPopovers } from '@components/Games/_common/popover_client';
  import { destroyMap, initMap } from './map_client';
  window.initMap = initMap;
  window.destroyMap = destroyMap;
  window.initSearchableSelects = initSearchableSelects;
  window.initPopovers = initPopovers;
</script>

<script is:inline define:vars={{ lang }}>
  const filterInput = document.getElementById('filter');
  const categorySelect = document.getElementById('category');
  const materialSelect = document.getElementById('material');
  const elementsGroup = document.querySelector(
    '[data-filter-group="elements"]',
  );
  const kindGroup = document.querySelector('[data-filter-group="kind"]');
  const list = document.getElementById('item-list');
  const pane = document.getElementById('detail-pane');

  let activeElements = [];
  let activeKinds = [];

  function applyFilters() {
    const term = filterInput?.value.toLowerCase() ?? '';
    const catVal = categorySelect?.value;
    const matVal = materialSelect?.value;
    const category = !catVal || catVal === '-1' ? '-1' : catVal;
    const material = !matVal || matVal === '-1' ? '-1' : matVal;

    document.querySelectorAll('#item-list .list-container').forEach((card) => {
      const name = card.querySelector('h4')?.textContent.toLowerCase() || '';
      const matchesName = name.includes(term);

      const cats = card.dataset.category?.split(',') ?? [];
      const matchesCategory = category === '-1' || cats.includes(category);

      const mats = card.dataset.material?.split(',') ?? [];
      const matchesMaterial = material === '-1' || mats.includes(material);

      const elements = card.dataset.elements?.split(',').filter(Boolean) ?? [];
      const matchesElements =
        activeElements.length === 0 ||
        activeElements.every((el) => elements.includes(el));

      const kind = card.dataset.kind;
      const matchesKind =
        activeKinds.length === 0 || activeKinds.includes(kind);

      card.style.display =
        matchesName &&
        matchesCategory &&
        matchesMaterial &&
        matchesElements &&
        matchesKind
          ? ''
          : 'none';
    });
  }

  filterInput?.addEventListener('input', applyFilters);
  categorySelect?.addEventListener('change', applyFilters);
  materialSelect?.addEventListener('change', applyFilters);
  elementsGroup?.addEventListener('filterchange', (e) => {
    activeElements = e.detail.active;
    applyFilters();
  });
  kindGroup?.addEventListener('filterchange', (e) => {
    activeKinds = e.detail.active;
    applyFilters();
  });

  // Master-Detail injection
  list?.addEventListener('click', async (e) => {
    const card = e.target.closest('.list-container');
    if (!card) return;

    if (e.button === 0 && !e.ctrlKey && !e.metaKey) {
      e.preventDefault();

      // If mobile, show the modal
      if (window.innerWidth <= 760) {
        pane.classList.add('is-open');
        if (!pane.querySelector('.close-btn')) {
          pane.insertAdjacentHTML(
            'afterbegin',
            `<button class="close-btn"><svg>
              <use href="/media/spritesheets/main.svg?v=1#fa-arrow-left" />
            </svg></button>`,
          );
          pane
            .querySelector('.close-btn')
            .addEventListener('click', () => pane.classList.remove('is-open'));
        }
      }
      pane.classList.add('hide-placeholder');

      window.destroyMap?.();
      const id = card.getAttribute('data-id');
      pane.querySelector('.content-area')?.remove(); // Clear old content

      const response = await fetch(`/yumia/items/${id}/fragment/${lang}`);
      const html = await response.text();

      pane.insertAdjacentHTML(
        'beforeend',
        `<div class="content-area">${html}</div>`,
      );
      window.initMap?.(pane.querySelector('.a26-map[data-points]'));
      window.initSearchableSelects?.(pane);
      window.initPopovers?.(pane);
    }
  });
</script>
