---
import { getCollection } from 'astro:content';
import ItemAttributeList from './ItemAttributeList.astro';
import Dropdown from '@components/Games/_common/Dropdown.astro';
import FilterButton from '@components/Games/_common/FilterButton.astro';
import {
  category_to_icon,
  element_map,
} from '@app/components/Games/yumia/yumia_constants';
import {
  category_translation,
  filter_translation,
} from '@app/localization/translations/common-strings';
import { material_translation } from '@app/localization/translations/yumia';

const { items, lang, title, game, section } = Astro.props;

const categories = await getCollection('yumia_categories');
const materials = await getCollection('yumia_materials');

const categoryOptions = categories.map((cat) => ({
  id: cat.id,
  label: cat.data.name[lang],
  icon: `/spritesheets/${game}.svg?v=1#${category_to_icon[cat.id]}`,
}));

const materialOptions = materials.map((o) => ({
  id: o.id,
  label: o.data.name[lang],
  icon: `/spritesheets/${game}.svg?v=1#material-${o.id}`,
}));

items.sort((a, b) => a.id.localeCompare(b.id, undefined, { numeric: true }));
---

<h1>{title}</h1>
<div class="master-detail">
  <div>
    <div class="filters">
      <input
        type="text"
        id="filter"
        placeholder={filter_translation[lang]}
        autocomplete="off"
        class="grid-12"
      />
      <Dropdown
        options={categoryOptions}
        name="category"
        placeholder={category_translation[lang]}
        lang={lang}
      />
      <Dropdown
        options={materialOptions}
        name="material"
        placeholder={material_translation[lang]}
        lang={lang}
      />
      <FilterButton
        svg={`${game}.svg?v=1`}
        extraClass="elements2"
        name="elements"
        list={[
          { filterKey: 'fire', icon: 'fire', activeColor: element_map.fire },
          { filterKey: 'ice', icon: 'ice', activeColor: element_map.ice },
          { filterKey: 'bolt', icon: 'bolt', activeColor: element_map.bolt },
          { filterKey: 'air', icon: 'air', activeColor: element_map.air },
        ]}
      />
      <FilterButton
        svg={`${game}.svg?v=1`}
        name="kind"
        singleOnly={true}
        list={[
          { filterKey: 'gather', icon: 'items' },
          { filterKey: 'consumable', icon: 'category-bombs' },
          { filterKey: 'synth', icon: 'synth' },
          { filterKey: 'equip', icon: 'equip' },
          { filterKey: 'explore', icon: 'exploration' },
          { filterKey: 'key', icon: 'category-key-items' },
          { filterKey: 'furniture', icon: 'category-interior' },
        ]}
      />
    </div>
    <ul
      class="list"
      id="item-list"
      data-lang={lang}
      data-game={game}
      data-section={section}
    >
      {
        items.map((i, index) => (
          <li
            class="list-container shrink-text"
            data-id={i.id}
            data-search={i.data.name[lang]}
            data-category={i.data.cats.map((c) => c.id).join(',')}
            data-material={i.data.mats?.map((c) => c.id).join(',')}
            data-elements={[
              i.data.fire && 'fire',
              i.data.ice && 'ice',
              i.data.bolt && 'bolt',
              i.data.air && 'air',
            ]
              .filter(Boolean)
              .join(',')}
            data-kind={i.data.kind}
          >
            {i.data.cats[0].id != 38 && (
              <img
                class="item-image-display"
                src={`/media/games/${game}/${section}/${i.id}.webp`}
                alt={i.data.name[lang]}
                loading={index < 25 ? 'eager' : 'lazy'}
              />
            )}
            <div class="card">
              <div class="card-title">
                <a href={`/yumia/items/${i.id}/${lang}`}>
                  <h4 class="item-trigger">{i.data.name[lang]}</h4>
                </a>
                {i.data.isDLC && <span class="badge bg-primary">DLC</span>}
              </div>
              <ItemAttributeList
                cats={i.data.cats}
                mats={i.data.mats}
                resonance={i.data.resonance}
                fire={i.data.fire}
                ice={i.data.ice}
                bolt={i.data.bolt}
                air={i.data.air}
                lang={lang}
                mode="list"
                game={game}
              />
            </div>
          </li>
        ))
      }
    </ul>
  </div>

  <div id="detail-pane" class="detail-pane">
    <svg class="placeholder-icon">
      <use href="/spritesheets/main.svg#flask"></use>
    </svg>
  </div>
</div>
<script>
  import { initListFilters } from '@app/utils/filter-controller';
  import { initPaneController } from '@app/utils/detail-pane-controller';
  initListFilters({
    filters: [
      { type: 'select', key: 'category', elementId: 'category' },
      { type: 'select', key: 'material', elementId: 'material' },
      { type: 'buttons', key: 'elements', groupName: 'elements', mode: 'all' },
      { type: 'buttons', key: 'kind', groupName: 'kind', mode: 'any' },
    ],
  });
  initPaneController({ withMap: true });
</script>
