---
import Detail from './Detail.astro';
import EffectList from '@components/Games/_common/List/EffectList.astro';

const { items, lang, title, game, section } = Astro.props;
---

<EffectList
  items={items}
  lang={lang}
  title={title}
  game={game}
  section={section}
  DetailComponent={Detail}
  getSearchText={(data: any, language: string) =>
    `${data.name[language].toLowerCase()} ^ ${data.desc1[language].toLowerCase()} ^ ${data.desc2?.[language]?.toLowerCase() ?? ''}`}
/>
<dialog id="map-modal" class="map-modal">
  <div id="modal-content"></div>
</dialog>
<style>
  .map-modal {
    width: 90vw;
    max-width: 800px;
    height: 80vh;
    padding: 2rem;
    border: none;
    background-color: transparent;

    &::backdrop {
      background: rgba(0, 0, 0, 0.7);
    }
  }
</style>
