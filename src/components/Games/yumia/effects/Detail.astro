---
import Effect from '@app/components/Games/_common/Detail/Effect.astro';
import AdvancedData from './AdvancedData.astro'
import AdvancedDataDisplay from '@app/components/Games/_common/Detail/AdvancedDataDisplay.astro';
import {
  inner_translation,
  outer_translation,
} from '@app/localization/translations/yumia';
import { item_translation } from '@app/localization/translations/common-strings';

const { item, lang, mode, game, section } = Astro.props;
---

<Effect
  name={item.name[lang]}
  game={game}
  mode={mode}
  desc={item.desc2 ? undefined : item.desc1[lang]}
  id={item.id}
  lang={lang}
>
  <span slot="icon">
    <b>Max: </b>{item.max_level}
  </span>

  {item.desc2 && (
      <p><b>{inner_translation[lang]}: </b>{item.desc1[lang]}</p>
      <p><b>{outer_translation[lang]}: </b>{item.desc2[lang]}</p>
  )}

  {item.items?.length > 0 && (
      <b style="margin-top: 1em;">{item_translation[lang]}:</b>
      <ul class="two-column">
        {item.items.map((i: any) => (
          <li><a href={`/${game}/items/${i.id}/${lang}`}>{i.name[lang]}</a></li>
        ))}
      </ul>
  )}

  <AdvancedDataDisplay mode={mode}>
    <AdvancedData item={item} />
  </AdvancedDataDisplay>
</Effect>
