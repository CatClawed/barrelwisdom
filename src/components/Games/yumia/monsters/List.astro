---
import { getCollection } from 'astro:content';
import Dropdown from '@components/Games/_common/Dropdown.astro';
import {
  filter_translation,
  race_translation,
} from '@app/localization/translations/common-strings';

const { items, lang, title, game, section } = Astro.props;

const races = await getCollection('yumia_races');

const raceOptions = races.map((race) => ({
  id: race.id,
  label: race.data.name[lang],
  icon: `/spritesheets/${game}.svg?v=1#race-${race.id}`,
}));

items.sort((a, b) => a.id.localeCompare(b.id, undefined, { numeric: true }));
---

<h1>{title}</h1>
<div class="master-detail">
  <div>
    <div class="filters">
      <input
        type="text"
        id="filter"
        placeholder={filter_translation[lang]}
        autocomplete="off"
        class="grid-8"
      />
      <Dropdown
        options={raceOptions}
        name="race"
        placeholder={race_translation[lang]}
        lang={lang}
      />
    </div>
    <ul
      class="list"
      id="item-list"
      data-lang={lang}
      data-game={game}
      data-section={section}
    >
      {
        items.map((i, index) => (
          <li
            class="list-container"
            data-id={i.id}
            data-search={i.data.name[lang]}
            data-race={i.data.race.id}
          >
            <img
              class="item-image-display"
              src={`/media/games/yumia/monsters/${i.id}.webp`}
              alt={i.data.name[lang]}
              loading={index < 25 ? 'eager' : 'lazy'}
            />
            <div class="card monster-display card-title">
              <a href={`/yumia/monsters/${i.id}/${lang}`}>
                <h3 class="item-trigger">{i.data.name[lang]}</h3>
              </a>
              {i.data.isDLC && <span class="badge bg-primary">DLC</span>}
              <svg>
                <use
                  href={`/spritesheets/${game}.svg?v=1#race-${i.data.race.id}`}
                />
              </svg>
            </div>
          </li>
        ))
      }
    </ul>
  </div>

  <div id="detail-pane" class="detail-pane">
    <svg class="placeholder-icon blue-placeholder">
      <use href={`/spritesheets/${game}.svg#puni`}></use>
    </svg>
  </div>
</div>
<script>
  import { initListFilters } from '@app/utils/filter-controller';
  import { initPaneController } from '@app/utils/detail-pane-controller';
  initListFilters({
    filters: [{ type: 'select', key: 'race', elementId: 'race' }],
  });
  initPaneController({ withMap: true });
</script>
