---
import ItemAttributeList from './ItemAttributeList.astro';
import Popover from '@app/components/Games/_common/Popover.astro';
import Map from './Map.astro';
import { element_map } from './yumia_constants';
import { sp_translation } from '@app/localization/translations/yumia';
import { effect_translation, item_translation } from '@app/localization/translations/common-strings';
import { monster_translation } from '@app/localization/translations/common-strings';
import { comfort_translation } from '@app/localization/translations/yumia';
import { material_translation } from '@app/localization/translations/yumia';
import { quality_translation } from '@app/localization/translations/common-strings';
import { inner_translation } from '@app/localization/translations/yumia';
import { outer_translation } from '@app/localization/translations/yumia';
import { details_translation } from '@app/localization/translations/common-strings';
const { item, lang } = Astro.props;

const level0 = item.recipe?.level[0];
const activeElements = level0 ? [
  { id: 'fire', active: level0.fire },
  { id: 'ice', active: level0.ice },
  { id: 'bolt', active: level0.bolt },
  { id: 'air', active: level0.air },
].filter((el) => el.active) : [];
---

<h1>{item.name}</h1>
{item.isDLC && <span class="badge bg-primary">DLC</span>}

{
  item.cats[0].id != 38 && (
    <img
      class="card-item-display"
      src={`/media/games/yumia/items/${item.id}.webp`}
      alt={item.name}
    />
  )
}

{item.desc && <p>{item.desc}</p>}

{
  item.quest && (
    <p>
      {item.quest.extra && <b>{item.quest.extra} </b>}
      {item.quest.name}
    </p>
  )
}

<ItemAttributeList
  cats={item.cats}
  mats={item.mats}
  lang={lang}
  isLink={true}
  resonance={item.resonance}
  fire={item.fire}
  ice={item.ice}
  bolt={item.bolt}
  air={item.air}
/>

{
  (item.atk || item.dfn || item.spd) && (
    <>
      <b>Stats:</b>
      <ul>
        {item.atk && (
          <li>
            <b>ATK: </b>
            {item.atk}
          </li>
        )}
        {item.dfn && (
          <li>
            <b>DFN: </b>
            {item.dfn}
          </li>
        )}
        {item.spd && (
          <li>
            <b>SPD: </b>
            {item.spd}
          </li>
        )}
      </ul>
    </>
  )
}
{(item.mons?.length > 0 || item.rare?.length > 0) && (
  <b>{monster_translation[lang]}</b>
  <ul>
    {item.mons?.map((mon) => (
      <li>
        <a href={`/yumia/monsters/${mon.id}/${lang}`}>{mon.name}</a>
      </li>
    ))}
    {item.rare?.map((mon) => (
      <li>
        <a href={`/yumia/monsters/${mon.id}/${lang}`}>{mon.name}</a>
      </li>
    ))}
  </ul>
)}
{item.material && (
  <>
    <b>{material_translation[lang]}</b>
    <ul>
      {item.material.recipe.map((r) => (
        <li>
          {r.mat.name} x{r.num}
        </li>
      ))}
    </ul>
  </>
)}

{item.comfort_goal && (
  <p>
    <b>{comfort_translation[lang]} </b>
    {item.comfort_goal} (see map)
    <svg class="icon">
      <use href="/media/spritesheets/main.svg?v=1#fa-arrow-down" />
    </svg>
  </p>
)}
{item.rank && (
  <table class="tbl">
    <thead>
      <tr>
        <th colspan="2">Rank Data</th>
      </tr>
    </thead>
    <tbody>
      {item.rank.map((rank) => (
        <tr>
          <td>{rank.rank}</td>
          <td>
            <ul style="list-style: none; padding: 0;">
              <li>
                <b>{quality_translation[lang]}: </b>
                {rank.quality}
              </li>
              {rank.eff?.map((e) => (
                <li>
                  <Popover
                    title={e.eff.name}
                    href={`/yumia/effects/${e.eff.id}/${lang}`}
                  >
                    <span slot="trigger">{e.eff.name} {e.lv}</span>

                    {!e.eff.desc2 ? (
                      <p>{e.eff.desc1}</p>
                    ) : (
                      <>
                        <p><b>{inner_translation[lang]}: </b>{e.eff.desc1}</p>
                        <p><b>{outer_translation[lang]}: </b>{e.eff.desc2}</p>
                      </>
                    )}

                    <p><b>Max: </b>{e.eff.max_level}</p>

                    <a href={`/yumia/effects/${e.eff.id}/${lang}`}>
                      {details_translation[lang]}
                    </a>
                  </Popover>
                </li>
              ))}
            </ul>
          </td>
        </tr>
      ))}
    </tbody>
  </table>
)}
{
  item.recipe && (
  <ul>
    <li><b>Amount Made:</b> {item.recipe.num}</li>
    <li><b>{sp_translation[lang]}</b> {item.recipe.sp}</li>
  </ul>

  <table class="tbl">
    <thead>
      <tr>
        <th style="width: 50%;">{item_translation[lang]}</th>
        <th style="width: 50%;">{effect_translation[lang]}</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <!-- Column 1: Items/Categories -->
        <td>
          <ul>
            {item.recipe.recipe.map((ing: any) => (
              <li>
                {ing.item ? (
                  <a href={`/yumia/items/${ing.item.id}/${lang}`}>{ing.item.name}</a>
                ) : (
                  <a href={`/yumia/categories/${ing.cat.id}/${lang}`}>{ing.cat.name}</a>
                )}
              </li>
            ))}
          </ul>
        </td>

        <!-- Column 2: Effects -->
        <td>
          <ul>
            {item.recipe.recipe.map((ing: any) => (
               ing.eff && (
                 <li>
                   <Popover
                     title={ing.eff.name}
                     href={`/yumia/effects/${ing.eff.id}/${lang}`}
                   >
                     <span slot="trigger">{ing.eff.name}</span>
                     {!ing.eff.desc2 ? (
                       <p>{ing.eff.desc1}</p>
                     ) : (
                       <>
                         <p><b>{inner_translation[lang]}: </b>{ing.eff.desc1}</p>
                         <p><b>{outer_translation[lang]}: </b>{ing.eff.desc2}</p>
                       </>
                     )}

                     <p><b>Max: </b>{ing.eff.max_level}</p>

                     <a href={`/yumia/effects/${ing.eff.id}/${lang}`}>
                       {details_translation[lang]}
                     </a>
                   </Popover>
                 </li>
               )
            ))}
          </ul>
        </td>
      </tr>
    </tbody>
  </table>

    <table class="tbl">
      <tr>
        <th colspan="2">
          <div style="display:inline-flex; align-items: center;">
            <span style="padding-right: 0.5em;">Level Data</span>

            {activeElements.map((el) => (
              <svg
                class="a26-elements"
                style={`background-color: ${element_map[el.id]};`}
              >
                <use href={`/media/spritesheets/A26.svg?v=1#${el.id}`} />
              </svg>
            ))}
          </div>
        </th>
      </tr>
      {item.recipe.level.map((lvl) => (
        <tr>
          <td>{lvl.lv}</td>
          <td>{lvl.reward}</td>
        </tr>
      ))}
    </table>
  )
}

<Map data={item.location} />
<style lang="scss">
  @use '@styles/games/yumia'
</style>
