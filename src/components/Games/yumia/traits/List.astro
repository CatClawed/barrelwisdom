---
import Detail from './Detail.astro';
import FilterButton from '@components/Games/_common/FilterButton.astro';
import { filter_translation } from '@app/localization/translations/common-strings';

const { items, lang, title } = Astro.props;

items.sort((a, b) => a.id.localeCompare(b.id, undefined, { numeric: true }));
---

<h1>{title}</h1>
<div class="filters">
  <input
    type="text"
    id="filter"
    placeholder={filter_translation[lang]}
    autocomplete="off"
    class="grid-6"
  />
  <FilterButton
    svg="A26.svg?v=1"
    name="traits"
    list={[
      { filterKey: 'atk', icon: 'category-bombs' },
      { filterKey: 'heal', icon: 'trait-heal' },
      { filterKey: 'buff', icon: 'trait-buff' },
      { filterKey: 'dbf', icon: 'trait-debuff' },
      { filterKey: 'wep', icon: 'category-weapons' },
      { filterKey: 'arm', icon: 'category-armor' },
      { filterKey: 'acc', icon: 'category-accessories' },
    ]}
  />
</div>
<ul class="list" id="item-list" data-lang={lang}>
  {
    items.map((i, index) => (
      <li
        class="list-container"
        data-id={i.id}
        data-search={`${i.data.name[lang].toLowerCase()} ${i.data.desc1[lang].toLowerCase()} ${i.data.desc2?.[lang]?.toLowerCase() ?? ''}`}
        data-traits={[
          i.data.wep && 'wep',
          i.data.arm && 'arm',
          i.data.acc && 'acc',
          i.data.atk && 'atk',
          i.data.heal && 'heal',
          i.data.buff && 'buff',
          i.data.dbf && 'dbf',
        ]
          .filter(Boolean)
          .join(',')}
      >
        <Detail item={i.data} lang={lang} mode="list" />
      </li>
    ))
  }
</ul>
<dialog id="map-modal" class="map-modal">
  <div id="modal-content"></div>
</dialog>
<script>
  import { initListFilters } from '@app/utils/filter-controller';
  import {
    initMap,
    destroyMap,
  } from '@app/components/Games/yumia/map/map_client';

  const lang = document.getElementById('item-list')!.dataset.lang!;
  initListFilters({
    lang,
    filters: [
      { type: 'buttons', key: 'traits', groupName: 'traits', mode: 'all' },
    ],
  });

  const list = document.getElementById('item-list');
  const modal = document.getElementById('map-modal') as HTMLDialogElement;
  const modalContent = document.getElementById('modal-content')!;

  list?.addEventListener('click', async (e) => {
    const trigger = (e.target as HTMLElement).closest('.show-map-btn');
    if (!trigger) return;

    destroyMap();

    const id = trigger.getAttribute('data-id');
    modalContent.innerHTML = '<p>Loading Map...</p>';
    modal.showModal();

    const response = await fetch(`/yumia/traits/${id}/fragment/${lang}`);
    const html = await response.text();
    modalContent.innerHTML = html;

    initMap(modalContent.querySelector('.a26-map[data-points]')!);
  });

  modal.addEventListener('click', (e) => {
    if (e.target === modal) {
      destroyMap();
      modal.close();
    }
  });
</script>
<style>
  .map-modal {
    width: 90vw;
    max-width: 800px;
    height: 80vh;
    padding: 2rem;
    border: none;
    background-color: transparent;

    &::backdrop {
      background: rgba(0, 0, 0, 0.7);
    }
  }
</style>
