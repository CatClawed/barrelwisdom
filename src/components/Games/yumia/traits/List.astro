---
import Detail from './Detail.astro';
import FilterButton from '@components/Games/_common/Filter/FilterButton.astro';
import TextFilter from '@components/Games/_common/Filter/TextFilter.astro';
import { traitFilterButtonsFor, traitFilterValues } from '@components/Games/_common/trait-filter-config';

const { items, lang, title, game, section } = Astro.props;

items.sort((a, b) => a.id.localeCompare(b.id, undefined, { numeric: true }));
---

<h1>{title}</h1>
<div class="filters">
  <TextFilter gridSize={8} lang={lang} />
  <FilterButton
    svg={`${game}.svg?v=1`}
    name="traits"
    list={traitFilterButtonsFor(game)}
  />
</div>
<ul
  class="list"
  id="item-list"
  data-lang={lang}
  data-game={game}
  data-section={section}
>
  {
    items.map((i, index) => (
      <li
        class="list-container"
        data-id={i.id}
        data-search={`${i.data.name[lang].toLowerCase()} ^ ${i.data.desc1[lang].toLowerCase()} ${i.data.desc2?.[lang]?.toLowerCase() ?? ''}`}
        data-traits={traitFilterValues(i.data, game)}
      >
        <Detail
          item={i.data}
          lang={lang}
          mode="list"
          game={game}
          section={section}
        />
      </li>
    ))
  }
</ul>
<dialog id="map-modal" class="map-modal">
  <div id="modal-content"></div>
</dialog>
<script>
  import { initListFilters } from '@app/utils/filter-controller';
  import { initModalMapController } from '@app/utils/modal-map-controller';
  initListFilters({
    filters: [
      { type: 'buttons', key: 'traits', groupName: 'traits', mode: 'all', excludeFullMatch: true },
    ],
  });
  initModalMapController({ game: 'yumia', section: 'traits' });
</script>
<style>
  .map-modal {
    width: 90vw;
    max-width: 800px;
    height: 80vh;
    padding: 2rem;
    border: none;
    background-color: transparent;

    &::backdrop {
      background: rgba(0, 0, 0, 0.7);
    }
  }
</style>
