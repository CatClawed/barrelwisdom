---
import Popover from '@app/components/Games/_common/Popover.astro';
import Map from '@app/components/Games/yumia/map/Map.astro';
import Trait from '@app/components/Games/_common/Detail/Trait.astro';
import { view_map_translation, outer_translation, inner_translation, blending_translation } from '@app/localization/translations/yumia';
import { level_translation } from '@app/localization/translations/common-strings';
const { item, lang, mode, game, section } = Astro.props;
const traitIcons = [
  { key: 'atk',  icon: 'category-bombs' },
  { key: 'heal', icon: 'trait-heal' },
  { key: 'buff', icon: 'trait-buff' },
  { key: 'dbf',  icon: 'trait-debuff' },
  { key: 'wep',  icon: 'category-weapons' },
  { key: 'arm',  icon: 'category-armor' },
  { key: 'acc',  icon: 'category-accessories' },
];
---
<Trait
  trait={item}
  mode={mode}
  game={game}
  lang={lang}
  section={section}
  icons={traitIcons}
>
  <div class="card-icon-position" slot="top-level">
    <Popover cls="dashed">
      <span slot="trigger">{level_translation[lang]}: </span>
      <p>A measure of rarity. This number determines where traits appear.</p>
    </Popover>

    {!item.grade_max ? ` ${item.grade_min}` : ` ${item.grade_min} - ${item.grade_max}`}
  </div>
  {!item.desc2 ? (<p>{item.desc1[lang]}</p>)
    : (
      <p><b>{inner_translation[lang]}: </b>{item.desc1[lang]}<br />
      <b>{outer_translation[lang]}: </b>{item.desc2[lang]}</p>
    )
  }
  {item.combo1 && (
    <b>{blending_translation[lang]}</b>
    <ul class="two-column">
      {[item.combo1, item.combo2, item.combo3, item.combo4].filter(Boolean).map((combo) => (
        <li>
          <a href={`/${game}/traits/${combo.id}/${lang}`}>{combo.name[lang]}</a>
        </li>
      ))}
    </ul>
  )}
  {item.trait_base && (
    <>
      {mode !== 'list' ? (
      <b>Advanced Data:</b>
      <ul>
        {[item.trait_base, item.trait_hash, item.lv_min_rand_range, item.lv_max_rand_range]
          .filter(val => val)
          .map((val) => (
            <li>{val}</li>
          ))
        }
      </ul>
      )
      : (
      <Popover cls="dashed">
        <span slot="trigger">Advanced Data</span>
        <ul>
          {[item.trait_base, item.trait_hash, item.lv_min_rand_range, item.lv_max_rand_range]
            .filter(val => val)
            .map((val) => (
              <li>{val}</li>
            ))
          }
        </ul>
      </Popover>
      <>
        { item.chests && mode === 'list' && (
        <button
          type="button"
          class="show-map-btn"
          data-id={item.id}
        >
          {view_map_translation[lang]}
        </button>
        )}
      </>
      )}
    </>
  )}
</Trait>
{mode !== 'list' && item.chests && <Map data={item.chests} /> }
<style>
.show-map-btn {
  background-color: var(--primary-color);
  color: white;
  border-radius: 5px;
  border: transparent;
  width: fit-content;
  padding: 0.2rem 0.5rem;
  margin-top: 1rem;
  cursor: pointer;
}
</style>
