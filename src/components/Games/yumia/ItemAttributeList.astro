---
import { category_to_icon, element_map } from './yumia_constants';

interface Props {
  cats: { id: string; name: string }[];
  mats?: { id: string; name: string }[];
  isLink?: boolean;
  lang?: string;
  resonance?: number;
  fire?: boolean;
  ice?: boolean;
  bolt?: boolean;
  air?: boolean;
}

const {
  cats,
  mats,
  lang,
  isLink = false,
  resonance,
  fire = false,
  ice = false,
  bolt = false,
  air = false,
} = Astro.props;

const getColor = (active: boolean | undefined, type: string) =>
  active ? element_map[type] : element_map['none'];

const elements = [
  { id: 'fire', active: fire },
  { id: 'ice', active: ice },
  { id: 'bolt', active: bolt },
  { id: 'air', active: air },
];
---

<div class="two-column" style={isLink ? undefined : 'height: 100%;'}>
  <ul style="padding-left: 0; list-style: none;">
    {
      cats.map((item) => (
        <li class="neat-display">
          <svg class="a26-icon">
            <use
              href={`/spritesheets/A26.svg?v=1#${category_to_icon[item.id]}`}
            />
          </svg>

          {isLink ? (
            <a href={`/yumia/categories/${item.id}/${lang}`}>{item.name}</a>
          ) : (
            <span>{item.name}</span>
          )}
        </li>
      ))
    }
  </ul>
  <ul style="padding-left: 0; list-style: none;">
    {
      mats?.map((item) => (
        <li class="neat-display">
          <svg class="a26-icon">
            <use href={`/spritesheets/A26.svg?v=1#material-${item.id}`} />
          </svg>
          <span>{item.name}</span>
        </li>
      ))
    }
  </ul>

{
  resonance && (
      <div class="neat-display" style="break-inside: avoid-column;">
        {elements.map((el) => (
          <svg
            class="a26-elements"
            style={`background-color: ${getColor(el.active, el.id)};`}
          >
            <use href={`/spritesheets/A26.svg?v=1#${el.id}`} />
          </svg>
        ))}
      </div>

      <div class="neat-display">
        <svg class="a26-icon">
          <use href="/spritesheets/A26.svg?v=1#resonance" />
        </svg>
        <span>{resonance} - {resonance + 5}</span>
      </div>
  )
}
</div>

<style lang="scss">
  @use '@styles/games/yumia';

  .neat-display {
    margin: auto auto 0 0;
    display: flex;
    align-items: center;
  }
</style>
