---
import { level_translation } from '@app/localization/translations/common-strings';

const { item, lang, game } = Astro.props;
---

<tr>
  <td>
    <a href={`/${game}/items/${item.id}/${lang}`}>{item.name[lang]}</a>
    {item.level && ` (${level_translation[lang]} ${item.level})`}
    {item.isDLC && <span class="badge bg-primary">DLC</span>}
    {item.isDX && <span class="badge bg-primary">DX</span>}
  </td>
</tr>
