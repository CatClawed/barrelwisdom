---
import Detail from './Detail.astro';
import FilterButton from '@components/Games/_common/Filter/FilterButton.astro';
import TextFilter from '@components/Games/_common/Filter/TextFilter.astro';

const { items, lang, title, game, section } = Astro.props;

items.sort((a, b) => a.data.index - b.data.index);
---

<h1>{title}</h1>
<div class="filters">
  <TextFilter gridSize={6} lang={lang} />
  <FilterButton
    svg={`${game}.svg?v=1`}
    name="traits"
    gridSpan={6}
    list={[
      { key: 'usable', icon: 'bomb' },
      { key: 'ingot', icon: 'weapon' },
      { key: 'cloth', icon: 'armor' },
      { key: 'accessory', icon: 'accessory' },
    ]}
  />
</div>
<ul
  class="list"
  id="item-list"
  data-lang={lang}
  data-game={game}
  data-section={section}
>
  {
    items.map((i, index) => (
      <li
        class="list-container"
        data-id={i.id}
        data-search={`${i.data.name[lang].toLowerCase()} ^ ${i.data.desc[lang].toLowerCase()} _ ${i.data.combo1 ? i.data.combo1.name[lang].toLowerCase() : ''} x ${i.data.combo2 ? i.data.combo2.name[lang].toLowerCase() : ''}`}
        data-traits={[
          i.data.synth && 'synth',
          i.data.usable && 'usable',
          i.data.ingot && 'ingot',
          i.data.cloth && 'cloth',
          i.data.accessory && 'accessory',
        ]
          .filter(Boolean)
          .join(',')}
      >
        <Detail
          item={i.data}
          lang={lang}
          mode="list"
          game={game}
          section={section}
        />
      </li>
    ))
  }
</ul>
<script>
  import { initListFilters } from '@app/utils/filter-controller';
  initListFilters({
    filters: [
      { type: 'buttons', key: 'traits', groupName: 'traits', mode: 'all' },
    ],
  });
</script>
