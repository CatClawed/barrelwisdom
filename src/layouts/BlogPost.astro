---
import FormattedDate from '@components/MainLayout/FormattedDate.astro';
import MainLayout from '@layouts/MainLayout.astro';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage, tags } =
  Astro.props;
---

<MainLayout title={title} description={description} mainClass="blog-post">
  <article>
    <h1>{title}</h1>
    <span class="svg-inline-text">
      <svg><use href="/media/spritesheets/main.svg?v=1#fa-calendar"></use></svg>
      <FormattedDate date={pubDate} />
    </span>
    {
      heroImage && (
        <img class="hero-image" loading="eager" src={heroImage} alt="" />
      )
    }
    <slot />
    {
      updatedDate && (
        <div class="last-updated-on">
          Last updated: <FormattedDate date={updatedDate} />
        </div>
      )
    }
    {
      tags.length > 0 && (
        <div class="tags">
          <svg>
            <use href="/spritesheets/main.svg#fa-tag" />
          </svg>
          {tags.map((tag) => (
            <a href={`/tags/${tag.toLowerCase().replace(/\s+/g, '-')}`}>
              {tag}
            </a>
          ))}
        </div>
      )
    }
  </article>
</MainLayout>
