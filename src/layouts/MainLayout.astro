---
import BaseHead from '@components/MainLayout/BaseHead.astro';
import Header from '@components/MainLayout/Header.astro';
import Sidebar from '@components/MainLayout/Sidebar.astro';
import Breadcrumb from '@components/MainLayout/Breadcrumb.astro';
import { getHtmlLang } from '@app/utils/navigation';

const { title, description, image, mainClass = undefined } = Astro.props;
const lang = getHtmlLang(Astro.url.pathname);
---

<html lang={lang}>
  <head>
    <BaseHead title={title} description={description} image={image} />
  </head>
  <body>
    <Header />
    <div class="layout-wrapper">
      <Sidebar />
      <main class={mainClass}>
        <Breadcrumb title={title} />
        <slot />
      </main>
    </div>
  </body>
</html>
