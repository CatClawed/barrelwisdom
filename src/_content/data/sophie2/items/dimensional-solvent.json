"}},"char2":{"id":"sophie","name":{"en":"Sophie","ja":"ソフィー","ko":"소피","sc":"苏菲","tc":"蘇菲"}},"char":{"id":"sophie","name":{"en":"Sophie","ja":"ソフィー","ko":"소피","sc":"苏菲","tc":"蘇菲"}}}