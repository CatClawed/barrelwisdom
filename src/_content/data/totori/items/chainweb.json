{"id":"chainweb","name":{"en":"Chainweb","ja":"鎖グモの巣"},"desc":{"en":"A chain woven like a spider's web. It occurs naturally, but what kind of spider spins chains? Pound for pound, it's stronger than steel.","ja":"鎖状に編まれたクモの巣。人工的なものでは ないのだが、どのクモがこんな巣を作るのか は未だに分かっていない。余談だが、クモの 巣は同じ細さの鉄よりも硬いらしい。"},"level":4,"locations":[{"id":"alanya-area","name":{"en":"Alanya Area","ja":"アランヤ周辺地域"}},{"id":"silver-lands","name":{"en":"Silver Lands","ja":"白銀の大地"}},{"id":"ancient-monastery","name":{"en":"Ancient Monastery","ja":"古の修道院"},"parent":"northern-ruins"}],"traits":{"id":"binding","name":{"en":"Binding","ja":"絡みつく"}},"categories":[{"id":"gunpowder","name":{"en":"(Gunpowder)","ja":"（火薬）"},"icon":"totori-category-gunpowder"},{"id":"supplement","name":{"en":"(Supplement)","ja":"（中和剤）"},"icon":"totori-category-supplement"},{"id":"threads","name":{"en":"(Threads)","ja":"（糸素材）"},"icon":"totori-category-threads"}],"item_type":"Ingredient","index":34}