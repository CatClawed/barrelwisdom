{"id":"dragon-scale","name":{"en":"Dragon Scale","ja":"竜のウロコ"},"desc":{"en":"As the name implies, it's a scale from a dragon. You'd think that since it has hundreds, they'd give you one if asked nicely. But that's not how things are.","ja":"名前の通り竜の鱗。鱗なんて何百枚もあるん だから、一枚くらいくれてもよさそうなもの だが、そんな気前のいい竜はそうそういない ので、やはり戦って勝ち取るしかない。"},"level":9,"monsters":[{"id":"raum-lizard","name":{"en":"Raum Lizard","ja":"ラウムリザード"}},{"id":"fran-pfeil","name":{"en":"Fran Pfeil","ja":"フラン・プファイル"}},{"id":"dragon","name":{"en":"Dragon","ja":"ドラゴン"}},{"id":"black-dragon","name":{"en":"Black Dragon","ja":"黒ドラゴン"}}],"traits":{"id":"healing-power","name":{"en":"Healing Power","ja":"癒しの力"}},"categories":[{"id":"mystery","name":{"en":"(Mystery)","ja":"（神秘の力）"},"icon":"totori-category-mystery"},{"id":"supplement","name":{"en":"(Supplement)","ja":"（中和剤）"},"icon":"totori-category-supplement"},{"id":"threads","name":{"en":"(Threads)","ja":"（糸素材）"},"icon":"totori-category-threads"}],"item_type":"Ingredient","index":73}