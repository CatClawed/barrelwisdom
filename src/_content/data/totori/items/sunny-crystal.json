{"id":"sunny-crystal","name":{"en":"Sunny Crystal","ja":"陽晶石"},"desc":{"en":"A crystal formed under bright sunlight. Charged with solar energy, it's almost blinding if you stare directly at it.","ja":"陽当たりの良い場所で生成される水晶。太陽 の光を目一杯含んでおり、眩しいほどに輝い ている。それ以外の点は、基本的に普通の水 晶とほぼ同じ性質。"},"level":7,"locations":[{"id":"continental-coastline","name":{"en":"Continental Coastline","ja":"大陸海岸線"}},{"id":"northern-ruins","name":{"en":"Northern Ruins","ja":"北方遺跡"}},{"id":"primordial-island","name":{"en":"Primordial Island","ja":"原初の島"}}],"traits":{"id":"fire-power","name":{"en":"Fire Power","ja":"炎の力"}},"categories":[{"id":"ore","name":{"en":"(Ore)","ja":"（鉱石類）"},"icon":"totori-category-ore"},{"id":"supplement","name":{"en":"(Supplement)","ja":"（中和剤）"},"icon":"totori-category-supplement"}],"item_type":"Ingredient","index":26}