{"id":"puniball","name":{"en":"Puniball","ja":"ぷにぷに玉"},"desc":{"en":"A ball removed from a defeated Puni. It's very bouncy at first, but it loses its texture and shape over time. Don't ask where the balls come from.","ja":"ぷにぷにから採れるぷにぷにした玉。指先で つまんでみると、とても心地よいが、時間が 経つと萎びていく。萎びてカサカサになって もぷにぷに玉はぷにぷに玉。"},"level":1,"monsters":[{"id":"blue-puni","name":{"en":"Blue Puni","ja":"青ぷに"}},{"id":"ear-puni","name":{"en":"Ear Puni","ja":"耳ぷに"}},{"id":"green-puni","name":{"en":"Green Puni","ja":"緑ぷに"}},{"id":"bunny-puni","name":{"en":"Bunny Puni","ja":"うさぷに"}}],"traits":{"id":"living","name":{"en":"Living","ja":"生きている"}},"categories":[{"id":"healing","name":{"en":"(Healing)","ja":"（薬品）"},"icon":"totori-category-healing"},{"id":"meat","name":{"en":"(Meat)","ja":"（食材・肉）"},"icon":"totori-category-meat"},{"id":"supplement","name":{"en":"(Supplement)","ja":"（中和剤）"},"icon":"totori-category-supplement"}],"item_type":"Ingredient","index":65}