{"id":"audra-s-tail","name":{"en":"Audra's Tail","ja":"アードラの尾羽"},"desc":{"en":"A tail feather from an Audra. Audras are typically blue, but when their feathers fall off, they turn red.","ja":"アードラの羽毛。アードラは青いのだが、羽 は抜け落ちると赤くなる。硬くて筋張ってい るので羽毛布団には向かないが、丈夫な布の 材料などに使われる。"},"level":3,"monsters":[{"id":"audra","name":{"en":"Audra","ja":"アードラ"}},{"id":"roc","name":{"en":"Roc","ja":"ロック鳥"}},{"id":"fresverg","name":{"en":"Fresverg","ja":"フレスヴェルグ"}}],"traits":{"id":"sturdy","name":{"en":"Sturdy","ja":"丈夫な"}},"categories":[{"id":"mystery","name":{"en":"(Mystery)","ja":"（神秘の力）"},"icon":"totori-category-mystery"},{"id":"supplement","name":{"en":"(Supplement)","ja":"（中和剤）"},"icon":"totori-category-supplement"},{"id":"threads","name":{"en":"(Threads)","ja":"（糸素材）"},"icon":"totori-category-threads"}],"item_type":"Ingredient","index":66}