{"id":"mandra-root","name":{"en":"Mandra Root","ja":"マンドラゴラの根"},"desc":{"en":"A plant in the form of a person. Commonly used in alchemy, it screams when cut or ground up. Not exactly the most pleasant item to work with.","ja":"人間の形をした植物。錬金術では非常によく 用いるのだが、切り刻んだり、すり潰したり する度に悲しげな悲鳴をあげるので、そうい う意味では非常に扱いにくい材料。"},"level":1,"monsters":[{"id":"mandragora","name":{"en":"Mandragora","ja":"マンドラゴラ"}},{"id":"witch-rose","name":{"en":"Witch Rose","ja":"ウィッチローズ"}}],"traits":{"id":"wound-healing","name":{"en":"Wound Healing","ja":"傷に効く"}},"categories":[{"id":"elixir","name":{"en":"(Elixir)","ja":"（エリキシル）"},"icon":"totori-category-elixir"},{"id":"healing","name":{"en":"(Healing)","ja":"（薬品）"},"icon":"totori-category-healing"},{"id":"poison","name":{"en":"(Poison)","ja":"（毒の材料）"},"icon":"totori-category-poison"},{"id":"supplement","name":{"en":"(Supplement)","ja":"（中和剤）"},"icon":"totori-category-supplement"}],"item_type":"Ingredient","index":70}