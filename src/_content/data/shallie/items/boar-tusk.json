{"id":"boar-tusk","name":{"en":"Boar Tusk","ja":"猪角","sc":"猪角","tc":"豬角"},"desc":{"en":"The tusk of a boar. Its bent shape and sharp tip are unique. Since it's full of fats, it only has a few uses and is not suitable for manufacturing.","ja":"猪の角。歪曲した形状と尖った先端部分が特徴。脂ぎっているため、加工には向かず、用途は多くない"},"level":5,"slots":2,"evalue":20,"wind":true,"earth":true,"effect":80,"kind":"Material","locations":[{"id":"crystal-valley","name":{"en":"Crystal Valley","ja":"結晶渓谷"},"parent":"eastern-continent"}],"monsters":[{"id":"boar","name":{"en":"Boar","ja":"イノシシ"}},{"id":"desert-boar","name":{"en":"Desert Boar","ja":"デザートボアー"}},{"id":"mountain-horn","name":{"en":"Mountain Horn","ja":"マウンテンホルン"}}],"categories":[{"id":"animal","name":{"en":"(Animal)","ja":"（動物素材）"},"icon":"category-animal"},{"id":"medic-ing","name":{"en":"(Medic. Ing.)","ja":"（薬材料）"},"icon":"category-elixir"}],"index":55,"enum":"ITEM_MAT_BOARS_HORN"}