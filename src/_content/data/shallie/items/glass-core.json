{"id":"glass-core","name":{"en":"Glass Core","ja":"グラスコア","sc":"玻璃核","tc":"玻璃核"},"desc":{"en":"A special crystal, both colorless and transparent. Since it doesn't distort light, it's hard to find it. It's fairly strong, but with some good effort it can be broken down into powder.","ja":"無色透明の特殊な石の結晶。光を屈折させないため、そこにあることを確かめるのも一苦労。それなりの強度を誇るが、力を加えると粉々に砕け散る"},"level":3,"slots":1,"evalue":20,"earth":true,"effect":60,"kind":"Material","locations":[{"id":"filled-cave","name":{"en":"Filled Cave","ja":"満ちたる洞窟"},"parent":"baskes-region"},{"id":"hole-of-the-dead","name":{"en":"Hole of the Dead","ja":"亡者の穴"},"parent":"eastern-continent"},{"id":"drifting-cemetery","name":{"en":"Drifting Cemetery","ja":"漂流墓地"},"parent":"eastern-continent"},{"id":"the-furthest-village","name":{"en":"The Furthest Village","ja":"最果て集落"},"parent":"eastern-continent"},{"id":"forest-of-miracles","name":{"en":"Forest of Miracles","ja":"奇跡の森"},"parent":"unexplored-lands"}],"monsters":[{"id":"amethyst-rat","name":{"en":"Amethyst Rat","ja":"アメジストラット"}},{"id":"amber-spirit","name":{"en":"Amber Spirit","ja":"琥珀のスピリット"}}],"properties":[{"id":"use-count-1","name":{"en":"Use Count +1","ja":"使用回数＋１"},"desc":{"en":"Increases item's use count by 1. Power is reduced by a small amount in exchange.","ja":"アイテムの使用回数が、１回分増加する。その代わり、威力が少し下がる"}}],"categories":[{"id":"ore","name":{"en":"(Ore)","ja":"（鉱石）"},"icon":"category-ore"}],"index":108,"enum":"ITEM_MAT_GLASS_CORE"}