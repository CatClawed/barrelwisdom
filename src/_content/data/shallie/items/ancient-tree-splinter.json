{"id":"ancient-tree-splinter","name":{"en":"Ancient Tree Splinter","ja":"古代樹の欠片","sc":"古代树的碎片","tc":"古代樹的碎片"},"desc":{"en":"A fragment of wood from a great tree that has stood since ancient times. Though it's been cut from the trunk, it has not lost its vivacious and fresh qualities, a sign of everlasting vitality.","ja":"古代からそびえ立つ大樹から取れた木片。幹から切り取られながら、その瑞々しさは失われず、果てしない生命力を発揮している"},"level":10,"slots":2,"evalue":15,"water":true,"earth":true,"effect":80,"kind":"Material","locations":[{"id":"geofront","name":{"en":"Geofront","ja":"ジオフロント"},"parent":"baskes-region"},{"id":"castle-of-mirages","name":{"en":"Castle of Mirages","ja":"陽炎の城"},"parent":"dusk-sea"},{"id":"crystal-valley","name":{"en":"Crystal Valley","ja":"結晶渓谷"},"parent":"eastern-continent"}],"categories":[{"id":"elixir","name":{"en":"(Elixir)","ja":"（エリキシル）"},"icon":"category-elixir"},{"id":"lumber","name":{"en":"(Lumber)","ja":"（木材）"},"icon":"category-lumber"}],"index":100,"enum":"ITEM_MAT_OLD_TREE_FRAGMENT"}