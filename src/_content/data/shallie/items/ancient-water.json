{"id":"ancient-water","name":{"en":"Ancient Water","ja":"太古の水","sc":"远古之水","tc":"遠古之水"},"desc":{"en":"Water that has seeped up from the depths of the earth over countless years. Compared to water remaining on the surface in the present day, even an amateur can see the great difference in clarity.","ja":"長い年月を経て大陸の地下から地上へと沸きだした水。現在地表に残る水と比べると、素人目にも透明度が違うことが分かる"},"level":19,"slots":2,"evalue":40,"water":true,"effect":90,"kind":"Material","locations":[{"id":"geofront","name":{"en":"Geofront","ja":"ジオフロント"},"parent":"baskes-region"},{"id":"seat-of-eternity","name":{"en":"Seat of Eternity","ja":"悠久の座"},"parent":"stellard-southern-archipelago"}],"categories":[{"id":"liquid","name":{"en":"(Liquid)","ja":"（液体）"},"icon":"category-liquid"},{"id":"medic-ing","name":{"en":"(Medic. Ing.)","ja":"（薬材料）"},"icon":"category-elixir"},{"id":"mystery","name":{"en":"(Mystery)","ja":"（神秘の力）"},"icon":"category-liquid"},{"id":"water","name":{"en":"(Water)","ja":"（水）"},"icon":"category-liquid"}],"index":130,"enum":"ITEM_MAT_ELDER_WATER"}