{"id":"anti-bug-grass","name":{"en":"Anti-Bug Grass","ja":"虫除け草","sc":"除虫草","tc":"除蟲草"},"desc":{"en":"Grass that secretes compounds that insects dislike. It's common to grow crops close to this to repel pests, and rubbing it on the body also has a pain relieving effect.","ja":"虫の嫌がる成分を分泌する草。作物の近くに植えて、虫除けとして使うが、身体にこすりつけると痛みが和らぐ薬効成分もある"},"slots":2,"evalue":10,"wind":true,"effect":50,"kind":"Material","locations":[{"id":"fertile-sea-eastern-area","name":{"en":"Fertile Sea - Eastern Area","ja":"豊饒の海・東部"},"parent":"stellard-southern-archipelago"},{"id":"fertile-sea","name":{"en":"Fertile Sea","ja":"豊饒の海"},"parent":"stellard-southern-archipelago"}],"monsters":[{"id":"poison-squirrel","name":{"en":"Poison Squirrel","ja":"ドクの実モモンガ"}},{"id":"grass-element","name":{"en":"Grass Element","ja":"草のエレメント"}},{"id":"yellow-elemental","name":{"en":"Yellow Elemental","ja":"霧葉のエレメント"}}],"categories":[{"id":"plant","name":{"en":"(Plant)","ja":"（植物類）"},"icon":"category-plant"},{"id":"smelly","name":{"en":"(Smelly)","ja":"（臭い）"},"icon":"category-aroma"}],"index":61,"enum":"ITEM_MAT_MOTHBALL_GRASS"}