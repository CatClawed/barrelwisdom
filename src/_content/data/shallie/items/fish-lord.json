{"id":"fish-lord","name":{"en":"Fish Lord","ja":"ぬし","sc":"鱼王","tc":"魚王"},"desc":{"en":"The master of the neighboring waters. Its size, weight, strength, and everything else are on a completely different level from common fish. Only an expert angler could hope to catch it.","ja":"界隈の水域のぬし。大きさ、重さ、力強さ、すべてが一般的な魚とは段違い。よほどの釣りの名手でなければ、釣り上げられない"},"level":14,"slots":4,"evalue":15,"fire":true,"water":true,"earth":true,"effect":90,"kind":"Material","locations":[{"id":"geofront","name":{"en":"Geofront","ja":"ジオフロント"},"parent":"baskes-region"},{"id":"green-desert","name":{"en":"Green Desert","ja":"緑の砂漠"},"parent":"stellard-southern-archipelago"}],"categories":[{"id":"elixir","name":{"en":"(Elixir)","ja":"（エリキシル）"},"icon":"category-elixir"},{"id":"fish","name":{"en":"(Fish)","ja":"（魚）"},"icon":"category-fish"},{"id":"medic-ing","name":{"en":"(Medic. Ing.)","ja":"（薬材料）"},"icon":"category-elixir"}],"index":75,"enum":"ITEM_MAT_NUSHI"}