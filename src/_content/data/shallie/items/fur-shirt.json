{"id":"fur-shirt","name":{"en":"Fur Shirt","ja":"毛皮のシャツ","sc":"毛皮衬衫","tc":"毛皮襯衫"},"desc":{"en":"A shirt made with plenty of animal pelts. Its high insulation is a selling point, and they sell like hotcakes during colder seasons. The fluffy feel is part of the secret to its popularity.","ja":"動物の毛皮をふんだんに使ったシャツ。保温性の高さがウリで、寒い時期には飛ぶように売れる。モコモコとした肌触りも、人気の秘密"},"level":10,"slots":1,"evalue":15,"fire":true,"wind":true,"kind":"Equipment","properties":[{"id":"transfer-pp-7","name":{"en":"Transfer PP +7","ja":"引継ぎＰＰ＋７"},"desc":{"en":"Increases transfer PP by 7 when this item is used as a material in Synthesis.","ja":"この潜力のついた材料を使って調合すると、引き継ぎＰＰ枠が７増加する"}},{"id":"hp-15","name":{"en":"HP +15","ja":"ＨＰ＋１５"},"desc":{"en":"Causes armor to increase maximum HP. Effect: Maximum HP increases by 15.","ja":"防具に最大ＨＰを上昇させる効果を付与する。効果：最大ＨＰが１５上昇する"}},{"id":"defense-10","name":{"en":"Defense +10","ja":"防御力＋１０"},"desc":{"en":"Causes armor to enhance defense. Effect: Increases defense by 10.","ja":"防具の防御力を強化する。効果：防御力が１０上昇する"}}],"categories":[{"id":"armor-clothes","name":{"en":"(Armor - Clothes)","ja":"（防具・服）"},"icon":"category-a-light-armor"},{"id":"pelt","name":{"en":"(Pelt)","ja":"（皮）"},"icon":"category-pelt"}],"ingredients":[{"category":{"id":"armor-clothes","name":{"en":"(Armor - Clothes)","ja":"（防具・服）"}}},{"item":{"id":"silkis-feather","name":{"en":"Silkis Feather","ja":"シルケスフェザー"}},"num":2},{"category":{"id":"pelt","name":{"en":"(Pelt)","ja":"（皮）"}}},{"category":{"id":"thread","name":{"en":"(Thread)","ja":"（糸素材）"}}}],"chars":["jurie","logy","homura","miruca","ayesha","solle","keithgriff","stera","kortes","wilbell","escha","lotte"],"stats":[{"hp":15,"mp":0,"atk":0,"defen":30,"spd":0}],"effectlines":[{"effects":[{"effect":{"id":"maximum-hp-20","name":{"en":"Maximum HP +20","ja":"ＨＰ最大値＋２０"},"desc":{"en":"Increases maximum HP value by 20.","ja":"最大ＨＰの値が２０上昇する"}},"number":1,"min_elem":30,"max_elem":49},{"effect":{"id":"maximum-mp-20","name":{"en":"Maximum MP +20","ja":"ＭＰ最大値＋２０"},"desc":{"en":"In