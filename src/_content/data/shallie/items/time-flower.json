{"id":"time-flower","name":{"en":"Time Flower","ja":"時守りの花","sc":"时光守护花","tc":"時光守護花"},"desc":{"en":"A flower said to form the basis for panaceas. The faintly glowing petals are a notable characteristic. It's rumored these are used as landmarks by descending angels, and thus treated with great care.","ja":"万能薬の元になると言われる花。うっすらと朧気に光を放つ花びらが特徴。天使が降りてくるときに目印にすると噂され、人々からは大切に扱われている"},"level":26,"slots":2,"evalue":20,"fire":true,"water":true,"wind":true,"earth":true,"effect":100,"kind":"Material","locations":[{"id":"seat-of-eternity","name":{"en":"Seat of Eternity","ja":"悠久の座"},"parent":"stellard-southern-archipelago"},{"id":"castle-of-mirages","name":{"en":"Castle of Mirages","ja":"陽炎の城"},"parent":"dusk-sea"}],"monsters":[{"id":"embodiment-of-nature","name":{"en":"Embodiment of Nature","ja":"自然の化身"}},{"id":"queen-of-eternal-night","name":{"en":"Queen of Eternal Night","ja":"常夜の女王"}},{"id":"phoenix-of-the-sea","name":{"en":"Phoenix of the Sea","ja":"大海を司る鳳"}}],"properties":[{"id":"count-bonus","name":{"en":"Count Bonus","ja":"回数補正"},"desc":{"en":"Effect: Increases item's power by use count x 1％.","ja":"効果：アイテムの威力が、使用回数×１％増加する"}},{"id":"hp-mp-enhance","name":{"en":"HP & MP Enhance","ja":"ＨＰＭＰ強化"},"desc":{"en":"Effect: Increases maximum HP and MP by 15.","ja":"効果：最大ＨＰとＭＰが１５上昇する"}}],"categories":[{"id":"ancient-power","name":{"en":"(Ancient Power)","ja":"（古代導力）"},"icon":"category-ancient-power"},{"id":"elixir","name":{"en":"(Elixir)","ja":"（エリキシル）"},"icon":"category-elixir"},{"id":"plant","name":{"en":"(Plant)","ja":"（植物類）"},"icon":"category-plant"}],"index":115,"enum":"ITEM_MAT_TIMELESS_FLOWER"}