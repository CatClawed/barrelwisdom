{"id":"evergreen-leaf","name":{"en":"Evergreen Leaf","ja":"常若の葉","sc":"常若之叶","tc":"常若之葉"},"desc":{"en":"A strange leaf that remains ever young, from the time the plant grows, to the time it dies. Even if the stem and roots are ruined, the leaves stay green.","ja":"植物が育ち、枯れるまで変わることなく瑞々しさを保つという変わった葉っぱ。茎や根が疲弊しても、葉だけは常に青々としている"},"level":12,"slots":2,"evalue":20,"water":true,"wind":true,"effect":60,"kind":"Material","locations":[{"id":"seat-of-eternity","name":{"en":"Seat of Eternity","ja":"悠久の座"},"parent":"stellard-southern-archipelago"},{"id":"heaven-s-vine","name":{"en":"Heaven's Vine","ja":"天上カズラ"},"parent":"eastern-continent"},{"id":"heaven-s-vine-root-division","name":{"en":"Heaven's Vine - Root Division","ja":"天上カズラ・株分け"},"parent":"eastern-continent"},{"id":"heaven-s-vine-sapling","name":{"en":"Heaven's Vine - Sapling","ja":"天上カズラ・若木"},"parent":"eastern-continent"}],"monsters":[{"id":"green-element","name":{"en":"Green Element","ja":"新緑のエレメント"}}],"categories":[{"id":"plant","name":{"en":"(Plant)","ja":"（植物類）"},"icon":"category-plant"}],"index":86,"enum":"ITEM_MAT_EVERGREEN_LEAF"}