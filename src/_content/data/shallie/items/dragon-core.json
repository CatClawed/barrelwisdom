{"id":"dragon-core","name":{"en":"Dragon Core","ja":"竜核","sc":"龙核","tc":"龍核"},"desc":{"en":"An internal organ of a dragon, as hard as a gemstone. While people always thought of this as a heart, recent studies have shown that this actually serves as a brain.","ja":"宝石のように固いドラゴンの器官。人間で言う心臓のようなものだと考えられて来たが、近年の研究でむしろ脳のようなものだということが分かっている"},"level":21,"slots":3,"evalue":20,"fire":true,"water":true,"wind":true,"earth":true,"effect":100,"kind":"Material","locations":[{"id":"geofront","name":{"en":"Geofront","ja":"ジオフロント"},"parent":"baskes-region"}],"categories":[{"id":"dragon-material","name":{"en":"(Dragon Material)","ja":"（竜素材）"},"icon":"category-dragon-material"},{"id":"elixir","name":{"en":"(Elixir)","ja":"（エリキシル）"},"icon":"category-elixir"},{"id":"gunpowder","name":{"en":"(Gunpowder)","ja":"（火薬）"},"icon":"category-gunpowder"},{"id":"ore","name":{"en":"(Ore)","ja":"（鉱石）"},"icon":"category-ore"}],"index":119,"enum":"ITEM_MAT_DRAGON_CORE"}