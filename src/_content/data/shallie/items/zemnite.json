{"id":"zemnite","name":{"en":"Zemnite","ja":"ゼムナイト","sc":"杰姆奈特","tc":"傑姆奈特"},"desc":{"en":"A crystal said to bestow the power of earth. Soil containing zemnite encourages the growth of plants, causing bizarre patches of well-developed greenery in the landscape.","ja":"大地に力を与えると言われている石の結晶。ゼムナイトの隠れている土は植物の促進を促し、その一帯だけ異様に成長した緑を見ることができる"},"level":5,"slots":3,"evalue":15,"water":true,"earth":true,"effect":60,"kind":"Material","locations":[{"id":"geofront","name":{"en":"Geofront","ja":"ジオフロント"},"parent":"baskes-region"},{"id":"drifting-cemetery","name":{"en":"Drifting Cemetery","ja":"漂流墓地"},"parent":"eastern-continent"},{"id":"heaven-s-vine-root-division","name":{"en":"Heaven's Vine - Root Division","ja":"天上カズラ・株分け"},"parent":"eastern-continent"},{"id":"herb-garden","name":{"en":"Herb Garden","ja":"地下薬草園"},"parent":"eastern-continent"},{"id":"herb-garden-depths","name":{"en":"Herb Garden - Depths","ja":"地下薬草園・深層"},"parent":"eastern-continent"}],"monsters":[{"id":"emerald-ray","name":{"en":"Emerald Ray","ja":"エメラルドレイ"}}],"properties":[{"id":"hp-big-increase","name":{"en":"HP Big Increase","ja":"ＨＰ大増量"},"desc":{"en":"Effect: Maximum HP increases by 40.","ja":"効果：最大ＨＰが４０上昇する"}},{"id":"eco-skill","name":{"en":"Eco Skill","ja":"エコスキル"},"desc":{"en":"Effect: Increases skill power by 10％.","ja":"効果：スキルの威力を、１０％上昇させる"}}],"categories":[{"id":"medic-ing","name":{"en":"(Medic. Ing.)","ja":"（薬材料）"},"icon":"category-elixir"},{"id":"natural","name":{"en":"(Natural)","ja":"（天然素材）"},"icon":"category-natural"}],"index":109,"enum":"ITEM_MAT_ZEMNITE"}