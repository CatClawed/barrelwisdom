{"id":"salt-eater","name":{"en":"Salt Eater","ja":"ソルトイーター"},"desc":{"en":"This rodent mainly feeds on salt. The fruit growing on its tail is very salty, and is sometimes used by chefs as a salt substitute. It's also as hard as rock salt.","ja":"塩を主食にしているネズミ。尻尾に成る実もしょっぱく、塩の代用品として料理人が使うこともある。実は岩塩のように硬い"},"race":{"en":"Animal","ja":"動物"},"hp":2070,"atk":234,"defen":86,"spd":154,"level":40,"exp":92,"cole":37,"locations":[{"id":"sea-of-eternity","name":{"en":"Sea of Eternity","ja":"奈落の海"},"parent":"baskes-region"},{"id":"herb-garden","name":{"en":"Herb Garden","ja":"地下薬草園"},"parent":"eastern-continent"},{"id":"herb-garden-depths","name":{"en":"Herb Garden - Depths","ja":"地下薬草園・深層"},"parent":"eastern-continent"},{"id":"water-garden-of-origins","name":{"en":"Water Garden of Origins","ja":"原初の水園"},"parent":"unexplored-lands"}],"drops":[{"id":"sand-crystal","name":{"en":"Sand Crystal","ja":"砂晶石"}},{"id":"marble-rock-salt","name":{"en":"Marble Rock Salt","ja":"マーブル岩塩"}}],"kind":"animal","index":4}