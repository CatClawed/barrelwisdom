{"id":"queen-of-eternal-night","name":{"en":"Queen of Eternal Night","ja":"常夜の女王"},"desc":{"en":"A spirit with a dark, sinking coloration, like the dead of night. Even among its kind, this spirit has a particularly strong hostility towards humans, and also far surpasses them in power.","ja":"真夜中のように、暗く沈んだ色の精霊。同種族の中でも特に人間に対して敵対心が強く、能力も抜きん出ている恐ろしい精霊"},"race":{"en":"Elemental","ja":"エレメンタル"},"hp":7100,"atk":503,"defen":209,"spd":281,"level":60,"exp":700,"cole":280,"note":"Strong enemy","locations":[{"id":"geofront","name":{"en":"Geofront","ja":"ジオフロント"},"parent":"baskes-region"},{"id":"seat-of-eternity","name":{"en":"Seat of Eternity","ja":"悠久の座"},"parent":"stellard-southern-archipelago"},{"id":"path-to-the-altar","name":{"en":"Path to the Altar","ja":"祭壇へ至る道"},"parent":"unexplored-lands"}],"drops":[{"id":"time-flower","name":{"en":"Time Flower","ja":"時守りの花"}}],"kind":"elemental","index":78}