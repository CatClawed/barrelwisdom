{"id":"marine-skin","name":{"en":"Marine Skin","ja":"マリーンスキン"},"desc":{"en":"A bear with bluish white fur. Quite contrary to its huge figure, it moves very fast, and hunters who face it without knowledge of this continue to fall victim to its claws.","ja":"青白い毛並みのクマ。巨体に似合わずすばやく動くため、情報を知らずに対峙したハンターを、次々とその爪の餌食にしているという"},"race":{"en":"Beast","ja":"猛獣"},"hp":2670,"atk":315,"defen":96,"spd":102,"level":40,"exp":105,"cole":42,"locations":[{"id":"sea-of-eternity","name":{"en":"Sea of Eternity","ja":"奈落の海"},"parent":"baskes-region"},{"id":"heaven-s-vine-root-division","name":{"en":"Heaven's Vine - Root Division","ja":"天上カズラ・株分け"},"parent":"eastern-continent"},{"id":"heaven-s-vine-sapling","name":{"en":"Heaven's Vine - Sapling","ja":"天上カズラ・若木"},"parent":"eastern-continent"},{"id":"altar-of-spirits","name":{"en":"Altar of Spirits","ja":"精霊の祭壇"},"parent":"unexplored-lands"}],"drops":[{"id":"beehive","name":{"en":"Beehive","ja":"ハチの巣"}}],"kind":"beast","index":16}