{"id":"fruit-hamster","name":{"en":"Fruit Hamster","ja":"フルーツハムスター"},"desc":{"en":"A mysterious rodent with treefruit growing on its tail. It's extremely wary, and will throw fruit at anything that approaches it. The fruit seems to regrow.","ja":"尻尾に木の実が成っている不思議なネズミ。警戒心が強く、近づくと実を投げて威嚇してくる。実はそのうち生えてくるらしい"},"race":{"en":"Animal","ja":"動物"},"hp":110,"atk":72,"defen":13,"spd":46,"level":4,"exp":4,"cole":2,"locations":[{"id":"woods-of-eternal-night","name":{"en":"Woods of Eternal Night","ja":"常夜林道"},"parent":"baskes-region"},{"id":"fertile-sea","name":{"en":"Fertile Sea","ja":"豊饒の海"},"parent":"stellard-southern-archipelago"},{"id":"fertile-sea-northern-area","name":{"en":"Fertile Sea - Northern Area","ja":"豊饒の海・北部"},"parent":"stellard-southern-archipelago"}],"drops":[{"id":"taun","name":{"en":"Taun","ja":"トーン"}}],"kind":"animal","index":1}