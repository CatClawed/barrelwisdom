{"id":"death-inquisitor","name":{"en":"Death Inquisitor","ja":"死の審問官","tc":"死亡審判官","sc":"死亡审判官"},"desc1":{"en":"You ate my pudding, didn't you?","ja":"「審問よ、答えて。…私のプリン食べたわね？」","tc":"「這是審判，回答我……妳吃掉了我的布丁吧？」","sc":"“这是审判，回答我……你吃掉了我的布丁吧？”"},"desc2":{"en":"Y-yes, I'm so sorry...","ja":"「は、はい、ごめんなさい、つい…」","tc":"「是、是的。對不起，一不注意……」","sc":"“是、是的。对不起，一不注意……”"},"desc3":{"en":"You were honest, I forgive you!","ja":"「…素直でよろしい！許してあげるっ！」","tc":"「……誠實是好事！原諒妳！」","sc":"“……诚实是好事！原谅你！”"},"desc4":{"en":"Are inquisitions really this forgiving?","ja":"「し、審問ってこんな緩いものなのかな…」","tc":"「審、審判有這麼寬鬆嗎……」","sc":"“审、审判有这么宽松吗……”"},"char1":"liane","char2":"firis","char3":"liane","char4":"firis","kind":"undead","hp":724,"atk":120,"defen":53,"spd":39,"level":46,"exp":238,"cole":79,"slash":2,"impact":1,"pierce":2,"magic":5,"fire":2,"ice":2,"light":3,"ail":3,"item_set":[{"id":"high-class-talisman","name":{"en":"High Class Talisman","ja":"高級なお札","tc":"高級卡牌","sc":"高级卡牌"}},{"id":"pendeloch","name":{"en":"Pendeloch","ja":"ペンデローク","tc":"梨形寶石","sc":"梨形宝石"}},{"id":"firebird-staff","name":{"en":"Firebird Staff","ja":"鳳凰の杖","tc":"鳳凰之杖","sc":"凤凰之杖"}},{"id":"gale-dagger","name":{"en":"Gale Dagger","ja":"疾風の小太刀","tc":"疾風的小太刀","sc":"疾风的小太刀"}},{"id":"hawkeye-bow","name":{"en":"Hawkeye Bow","ja":"鷹の目の弓","tc":"鷹眼之弓","sc":"鹰眼之弓"}},{"id":"silver-gun","name":{"en":"Silver Gun","ja":"銀装飾の銃","tc":"銀裝飾鎗","sc":"银装饰枪"}},{"id":"moon-caller","name":{"en":"Moon Caller","ja":"ムーンコーリング","tc":"月光呼應","sc":"月光呼应"}},{"id":"nightshade","name":{"en":"Nightshade","ja":"ナイトシェイド","tc":"夜影","sc":"夜影"}},{"id":"colorful-vest","name":{"en":"Colorful Vest","ja":"極彩色ベスト","tc":"極亮彩背心","sc":"极亮彩背心"}}],"locations":[{"id":"timelost-lake","name":{"en":"Timelost Lake","ja":"時隠れの湖","tc":"時隱之湖","sc":"时隐之湖"}},{"id":"ertona-underground-lake","name":{"en":"Ertona Underground Lake","ja":"エルトナ地底湖","tc":"艾爾托納地底湖","sc":"艾尔托纳地底湖"}},{"id":"wavebreaker-cove","name":{"en":"Wavebreaker Cove","ja":"波座の伏籠","tc":"止浪的伏籠","sc":"止浪的伏笼"}}],"index":122}