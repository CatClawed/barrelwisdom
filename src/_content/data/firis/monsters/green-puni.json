{"id":"green-puni","name":{"en":"Green Puni","ja":"緑プニ","tc":"綠噗尼","sc":"绿噗尼"},"desc1":{"en":"This is a green Puni. There's so manydifferent colors of Puni, it's so fun.","ja":"「緑色のプニね。プニは色んな色のがいるから、　眺めてるだけでも楽しいわね」","tc":"「這是綠色的噗尼。噗尼有很多種顏色，　光是看都覺得有趣呢。」","sc":"“这是绿色的噗尼。噗尼有很多种颜色，　光是看都觉得有趣呢。”"},"desc2":{"en":"Yeah, I'd like to display them in the atelier!","ja":"「うん、アトリエに並べて飾ってみたいなー」","tc":"「嗯，真想在工房裡擺一排當作裝飾品呀。」","sc":"“嗯，真想在工房里摆一排当作装饰品呀。”"},"desc3":{"en":"Y-you plan on preserving them...?","ja":"「は、剥製にでもするつもり…？」","tc":"「要、要做成標本嗎……？」","sc":"“要、要做成标本吗……？”"},"char1":"liane","char2":"firis","char3":"liane","kind":"puni","hp":33,"atk":8,"defen":5,"spd":5,"level":7,"exp":5,"slash":1,"impact":1,"pierce":3,"magic":2,"fire":1,"ice":2,"light":2,"ail":2,"item_set":[{"id":"puniball-blue","name":{"en":"Puniball: Blue","ja":"プニプニ玉・青","tc":"噗尼噗尼珠‧藍","sc":"噗尼噗尼珠‧蓝"}},{"id":"puniball-green","name":{"en":"Puniball: Green","ja":"プニプニ玉・緑","tc":"噗尼噗尼珠‧綠","sc":"噗尼噗尼珠‧绿"}},{"id":"puniball-red","name":{"en":"Puniball: Red","ja":"プニプニ玉・赤","tc":"噗尼噗尼珠‧紅","sc":"噗尼噗尼珠‧红"}},{"id":"puniball-gold","name":{"en":"Puniball: Gold","ja":"プニプニ玉・金","tc":"噗尼噗尼珠‧金","sc":"噗尼噗尼珠‧金"}},{"id":"puni-fluid","name":{"en":"Puni Fluid","ja":"プニの体液","tc":"噗尼的體液","sc":"噗尼的体液"}}],"locations":[{"id":"faave-hills","name":{"en":"Faave Hills","ja":"ファーヴェ丘陵","tc":"法維丘陵","sc":"法维丘陵"}},{"id":"southern-plains","name":{"en":"Southern Plains","ja":"南方原野","tc":"南方原野","sc":"南方原野"}},{"id":"traveler-s-grove","name":{"en":"Traveler's Grove","ja":"旅人の雑木林","tc":"旅人的雜木林","sc":"旅人的杂木林"}},{"id":"parched-plains","name":{"en":"Parched Plains","ja":"乾いた平野帯","tc":"乾枯平原帶","sc":"干枯平原带"}},{"id":"ertona-underground-lake","name":{"en":"Ertona Underground Lake","ja":"エルトナ地底湖","tc":"艾爾托納地底湖","sc":"艾尔托纳地底湖"}}],"index":72}