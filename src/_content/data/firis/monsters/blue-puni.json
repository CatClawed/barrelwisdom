{"id":"blue-puni","name":{"en":"Blue Puni","ja":"青プニ","tc":"藍噗尼","sc":"蓝噗尼"},"desc1":{"en":"These are squishy monsters you'll find everywhere.They feel nice to touch, but... Poke poke.","ja":"「どこにでもいるプニプニした魔物ね。　なかなかのさわり心地だけど…つんつん」","tc":"「隨處可見、充滿彈性的魔物。　雖然摸起來的觸感不錯……我戳我戳。」","sc":"“随处可见、充满弹性的魔物。　虽然摸起来的触感不错……我戳我戳。”"},"desc2":{"en":"Why are you poking my cheek?","ja":"「うわっ！…なんでほっぺたつつくの？」","tc":"「嗚哇！為什麼要戳我的臉啊？」","sc":"“呜哇！为什么要戳我的脸啊？”"},"desc3":{"en":"Because this one feels better.","ja":"「ふふ、こっちの方がいいさわり心地だなって」","tc":"「嘻嘻，因為我覺得這邊的觸感比較好啊。」","sc":"“嘻嘻，因为我觉得这边的触感比较好啊。”"},"char1":"liane","char2":"firis","char3":"liane","kind":"puni","hp":23,"atk":5,"defen":3,"spd":3,"level":3,"exp":2,"slash":1,"impact":1,"pierce":3,"magic":2,"fire":1,"ice":2,"light":2,"ail":2,"item_set":[{"id":"puniball-blue","name":{"en":"Puniball: Blue","ja":"プニプニ玉・青","tc":"噗尼噗尼珠‧藍","sc":"噗尼噗尼珠‧蓝"}},{"id":"puniball-green","name":{"en":"Puniball: Green","ja":"プニプニ玉・緑","tc":"噗尼噗尼珠‧綠","sc":"噗尼噗尼珠‧绿"}},{"id":"puniball-red","name":{"en":"Puniball: Red","ja":"プニプニ玉・赤","tc":"噗尼噗尼珠‧紅","sc":"噗尼噗尼珠‧红"}},{"id":"puniball-gold","name":{"en":"Puniball: Gold","ja":"プニプニ玉・金","tc":"噗尼噗尼珠‧金","sc":"噗尼噗尼珠‧金"}},{"id":"puni-fluid","name":{"en":"Puni Fluid","ja":"プニの体液","tc":"噗尼的體液","sc":"噗尼的体液"}}],"locations":[{"id":"faave-hills","name":{"en":"Faave Hills","ja":"ファーヴェ丘陵","tc":"法維丘陵","sc":"法维丘陵"}},{"id":"parched-plains","name":{"en":"Parched Plains","ja":"乾いた平野帯","tc":"乾枯平原帶","sc":"干枯平原带"}},{"id":"south-auoro-snowfield","name":{"en":"South Auoro Snowfield","ja":"南アオロ雪原","tc":"南奧羅雪原","sc":"南奥罗雪原"}},{"id":"ertona-underground-lake","name":{"en":"Ertona Underground Lake","ja":"エルトナ地底湖","tc":"艾爾托納地底湖","sc":"艾尔托纳地底湖"}}],"index":71}