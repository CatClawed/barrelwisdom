{"id":"beast-captain","name":{"en":"Beast Captain","ja":"ケモノ兵長","tc":"獸人兵長","sc":"兽人兵长"},"desc1":{"en":"He takes care of his troops, and they followhim excellently, so he's a good captain.","ja":"「面倒見が良くて、優秀で…　部下から慕われてる、いい兵長みたいよ？」","tc":"「擅長照顧人又優秀……　好像是廣受部下們仰慕的好兵長喔？」","sc":"“擅长照顾人又优秀……　好像是广受部下们仰慕的好兵长哦？”"},"desc2":{"en":"Really? But, how do you know that?","ja":"「へぇ…！でも、どうして知ってるの？」","tc":"「哦……！不過，妳為什麼會知道啊？」","sc":"“哦……！不过，你为什么会知道啊？”"},"desc3":{"en":"I just thought it up now.","ja":"「ん？…今考えたの」","tc":"「嗯？我剛剛想出來的。」","sc":"“嗯？我刚刚想出来的。”"},"char1":"liane","char2":"firis","char3":"liane","kind":"humanoid","hp":548,"atk":49,"defen":21,"spd":34,"level":45,"exp":113,"cole":57,"slash":2,"impact":2,"pierce":1,"magic":5,"fire":2,"ice":2,"light":2,"ail":1,"item_set":[{"id":"milk","name":{"en":"Milk","ja":"ミルク","tc":"鮮奶","sc":"鲜奶"}},{"id":"animal-hide","name":{"en":"Animal Hide","ja":"動物の皮革","tc":"動物皮革","sc":"动物皮革"}},{"id":"fresh-meat","name":{"en":"Fresh Meat","ja":"新鮮な肉","tc":"新鮮的肉","sc":"新鲜的肉"}},{"id":"beast-meat","name":{"en":"Beast Meat","ja":"ケモノ肉","tc":"野獸之肉","sc":"野兽之肉"}},{"id":"mirage-sword","name":{"en":"Mirage Sword","ja":"陽炎の剣","tc":"陽炎之劍","sc":"阳炎之剑"}},{"id":"berserk-blade","name":{"en":"Berserk Blade","ja":"ベルセルクブレイド","tc":"狂戰士之劍","sc":"狂战士之剑"}},{"id":"pole-axe","name":{"en":"Pole Axe","ja":"ポールアクス","tc":"戟斧","sc":"戟斧"}},{"id":"cross-spear","name":{"en":"Cross Spear","ja":"クロススピア","tc":"十字槍","sc":"十字枪"}},{"id":"bone-mail","name":{"en":"Bone Mail","ja":"ボーンメイル","tc":"骨甲","sc":"骨甲"}},{"id":"tamahagane-mail","name":{"en":"Tamahagane Mail","ja":"玉鋼フルメイル","tc":"玉鋼全身甲","sc":"玉钢全身甲"}}],"locations":[{"id":"heavenly-tree-einhorn","name":{"en":"Heavenly Tree Einhorn","ja":"天衝樹アインホルン","tc":"衝天樹艾因赫倫","sc":"冲天树艾因赫伦"}}],"index":4}