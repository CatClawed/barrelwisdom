{"id":"funny-face","name":{"en":"Funny Face","ja":"ファニーフェイス","tc":"鬼臉","sc":"鬼脸"},"desc1":{"en":"Lia, Lia! Look, a funny face!","ja":"「リア姉、リア姉ー。ほら、変な顔ー！」","tc":"「莉亞姊、莉亞姊──看我的鬼臉──！」","sc":"“莉亚姐、莉亚姐──看我的鬼脸──！”"},"desc2":{"en":"Don't surprise me like that! That'snot a face a girl should make... Haha...","ja":"「ぶふっ！？ふ、不意打ちはやめてっ、くく…！　女の子がしちゃダメな顔よ、それ…ぷぷ…！」","tc":"「噗呼！？不、不要偷襲啦、咕呼……！　女孩子不可以擺出這種臉啦……噗噗……！」","sc":"“噗呼！？不、不要偷袭啦、咕呼……！　女孩子不可以摆出这种脸啦……噗噗……！”"},"desc3":{"en":"I couldn't be outdone by a monster!","ja":"「ふふふ、魔物には負けてられないからね！」","tc":"「嘻嘻嘻，我可不會輸給魔物呢！」","sc":"“嘻嘻嘻，我可不会输给魔物呢！”"},"char1":"firis","char2":"liane","char3":"firis","kind":"undead","hp":750,"atk":59,"defen":80,"spd":78,"level":39,"exp":208,"cole":310,"slash":4,"impact":4,"pierce":4,"magic":2,"fire":2,"ice":3,"light":2,"ail":2,"item_set":[{"id":"paper-scrap","name":{"en":"Paper Scrap","ja":"破れた紙片","tc":"破碎的紙片","sc":"破碎的纸片"}},{"id":"church-talisman","name":{"en":"Church Talisman","ja":"教会のお札","tc":"教會卡牌","sc":"教会卡牌"}},{"id":"high-class-talisman","name":{"en":"High Class Talisman","ja":"高級なお札","tc":"高級卡牌","sc":"高级卡牌"}},{"id":"pious-talisman","name":{"en":"Pious Talisman","ja":"敬虔な信者用お札","tc":"虔誠信徒用卡牌","sc":"虔诚信徒用卡牌"}},{"id":"pendeloch","name":{"en":"Pendeloch","ja":"ペンデローク","tc":"梨形寶石","sc":"梨形宝石"}},{"id":"firebird-staff","name":{"en":"Firebird Staff","ja":"鳳凰の杖","tc":"鳳凰之杖","sc":"凤凰之杖"}},{"id":"phoenix-staff","name":{"en":"Phoenix Staff","ja":"不死鳥の杖","tc":"不死鳥之杖","sc":"不死鸟之杖"}},{"id":"flame-sword","name":{"en":"Flame Sword","ja":"焔光剣","tc":"焰光劍","sc":"焰光剑"}},{"id":"wyrmsoul","name":{"en":"Wyrmsoul","ja":"ウィルムソウル","tc":"亞龍之魂","sc":"亚龙之魂"}},{"id":"gale-dagger","name":{"en":"Gale Dagger","ja":"疾風の小太刀","tc":"疾風的小太刀","sc":"疾风的小太刀"}},{"id":"hidden-dagger","name":{"en":"Hidden Dagger","ja":"隠密の小太刀","tc":"隱密的小太刀","sc":"隐密的小太刀"}},{"id":"halberd","name":{"en":"Halberd","ja":"ハルベルト","tc":"槍斧","sc":"枪斧"}},{"id":"white-wing-spear","name":{"en":"White Wing Spear","ja":"白翼の槍","tc":"白翼之槍","sc":"白翼之枪"}},{"id":"hawkeye-bow","name":{