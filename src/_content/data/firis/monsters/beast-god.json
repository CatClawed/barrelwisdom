{"id":"beast-god","name":{"en":"Beast God","ja":"ケモノ神","tc":"獸人神","sc":"兽人神"},"desc1":{"en":"Firis, what are you doing?","ja":"「フィリスちゃん、何してるの？」","tc":"「菲莉絲，妳在做什麼呀？」","sc":"“菲利丝，你在做什么呀？”"},"desc2":{"en":"Hm? ...Praying.I thought it'd answer my prayers.","ja":"「うん？…お祈り。　神様なら、お願い叶えてくれるかなって」","tc":"「嗯？我呀……在祈禱。　既然是神的話，應該可以實現願望吧。」","sc":"“嗯？我呀……在祈祷。　既然是神的话，应该可以实现愿望吧。”"},"desc3":{"en":"No, I think it's just a beast.","ja":"「いやぁ、所詮はケモノだと思うわよ…？」","tc":"「不不，再怎麼說也還是獸人喔……？」","sc":"“不不，再怎么说也还是兽人哦……？”"},"char1":"liane","char2":"firis","char3":"liane","kind":"humanoid","hp":2100,"atk":120,"defen":89,"spd":153,"level":60,"exp":769,"cole":385,"slash":6,"impact":6,"pierce":6,"magic":2,"fire":2,"ice":2,"light":2,"ail":2,"item_set":[{"id":"milk","name":{"en":"Milk","ja":"ミルク","tc":"鮮奶","sc":"鲜奶"}},{"id":"animal-hide","name":{"en":"Animal Hide","ja":"動物の皮革","tc":"動物皮革","sc":"动物皮革"}},{"id":"sternbogen","name":{"en":"Sternbogen","ja":"シュテルネボーゲン","tc":"星之射手","sc":"星之射手"}},{"id":"earth-splitter-carolina","name":{"en":"Earth Splitter Carolina","ja":"地壊しカロリーネ","tc":"裂地的卡洛里內","sc":"裂地的卡洛里内"}},{"id":"falcata","name":{"en":"Falcata","ja":"ファルカタ","tc":"軍用曲刀","sc":"军用曲刀"}},{"id":"demonblade-valdberg","name":{"en":"Demonblade Valdberg","ja":"魔剣ヴァルトベルグ","tc":"魔劍瓦爾特貝魯格","sc":"魔剑瓦尔特贝鲁格"}},{"id":"dragon-destroyer","name":{"en":"Dragon Destroyer","ja":"竜葬剣『荒羽根断ち』","tc":"龍葬劍『荒羽根絕』","sc":"龙葬剑“荒羽根绝”"}},{"id":"mistral-bringer","name":{"en":"Mistral Bringer","ja":"ミストラルブリンガー","tc":"北風使者","sc":"北风使者"}},{"id":"plate-vest","name":{"en":"Plate Vest","ja":"プレートベスト","tc":"板甲背心","sc":"板甲背心"}},{"id":"journey-coat","name":{"en":"Journey Coat","ja":"旅のコート","tc":"旅行外套","sc":"旅行外套"}},{"id":"mysterious-plate","name":{"en":"Mysterious Plate","ja":"神秘のプレート","tc":"神祕胸鎧","sc":"神秘胸铠"}},{"id":"journey-plate","name":{"en":"Journey Plate","ja":"旅のプレート","tc":"旅行胸鎧","sc":"旅行胸铠"}}],"locations":[{"id":"heavenly-tree-einhorn","name":{"en":"Heavenly Tree Einhorn","ja":"天衝樹アインホルン","tc":"衝天樹艾因赫倫","sc":"冲天树艾因赫伦"}}],"index":6}