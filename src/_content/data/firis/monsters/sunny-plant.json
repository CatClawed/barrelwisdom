{"id":"sunny-plant","name":{"en":"Sunny Plant","ja":"サニープランツ","tc":"陽光植物","sc":"阳光植物"},"desc1":{"en":"A plant monster that loves the sun. They're oftenseen basking in the sun here and there.","ja":"「太陽が好きな植物の魔物ね。　よくそこらで日向ぼっこしてるみたい」","tc":"「這是喜歡太陽的植物魔物，　經常會隨便找個地方曬太陽喔。」","sc":"“这是喜欢太阳的植物魔物，　经常会随便找个地方晒太阳哦。”"},"desc2":{"en":"That'd be nice, laying in the sun!I want to go lay with them too!","ja":"「いいなぁ、日向ぼっこ！　わたしも隣で一緒にしたい！」","tc":"「曬太陽，真好耶！　我也想在旁邊一起曬！」","sc":"“晒太阳，真好耶！　我也想在旁边一起晒！”"},"char1":"liane","char2":"firis","kind":"plant","hp":334,"atk":29,"defen":10,"spd":14,"level":28,"exp":45,"slash":2,"impact":4,"pierce":2,"magic":2,"fire":4,"ice":1,"light":3,"ail":2,"item_set":[{"id":"tall-taun","name":{"en":"Tall Taun","ja":"セイタカトーン","tc":"長頸通草","sc":"长颈通草"}},{"id":"red-flower","name":{"en":"Red Flower","ja":"赤い花","tc":"紅色的花","sc":"红色的花"}},{"id":"blue-flower","name":{"en":"Blue Flower","ja":"青い花","tc":"藍色的花","sc":"蓝色的花"}},{"id":"green-flower","name":{"en":"Green Flower","ja":"緑色の花","tc":"綠色的花","sc":"绿色的花"}},{"id":"yellow-flower","name":{"en":"Yellow Flower","ja":"黄色い花","tc":"黃色的花","sc":"黄色的花"}},{"id":"purple-flower","name":{"en":"Purple Flower","ja":"紫色の花","tc":"紫色的花","sc":"紫色的花"}},{"id":"walnut","name":{"en":"Walnut","ja":"クルミ","tc":"核桃","sc":"核桃"}},{"id":"cannon-fruit","name":{"en":"Cannon Fruit","ja":"カノンの実","tc":"加農的果實","sc":"加农的果实"}},{"id":"nectar-fruit","name":{"en":"Nectar Fruit","ja":"甘露の実","tc":"甘露的果實","sc":"甘露的果实"}},{"id":"zwei-nuts","name":{"en":"Zwei Nuts","ja":"ツヴァイナッツ","tc":"雙核堅果","sc":"双核坚果"}},{"id":"oil-tree-fruit","name":{"en":"Oil Tree Fruit","ja":"アブラ木の実","tc":"油木的果實","sc":"油木的果实"}},{"id":"cinders","name":{"en":"Cinders","ja":"消し炭","tc":"軟碳","sc":"软碳"}}],"locations":[{"id":"weist-plain","name":{"en":"Weist Plain","ja":"ウェイスト・プレイン","tc":"廢棄平原","sc":"废弃平原"}}],"index":14}