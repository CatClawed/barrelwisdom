{"id":"red-puni","name":{"en":"Red Puni","ja":"赤プニ","tc":"紅噗尼","sc":"红噗尼"},"desc1":{"en":"Did it see me and start blushing?","ja":"「まぁ、私に見とれて照れちゃってるのかしら」","tc":"「哎呀，這是看到我覺得害羞了嗎？」","sc":"“哎呀，这是看到我觉得害羞了吗？”"},"desc2":{"en":"They change color depending on thefood they eat.","ja":"「ううん。食べる物によって色が変わるだけ。　別に、見とれて赤くなってるんじゃないよ」","tc":"「不是啦，只是會隨著吃進去的東西變色而已，　並不是覺得害羞什麼的哦。」","sc":"“不是啦，只是会随着吃进去的东西变色而已，　并不是觉得害羞什么的哦。”"},"desc3":{"en":"I was just joking, you didn't need to explain it.","ja":"「じょ、冗談なのに真顔で解説しなくても…」","tc":"「我、我只是開玩笑，不用那麼認真解釋吧……」","sc":"“我、我只是开玩笑，不用那么认真解释吧……”"},"char1":"liane","char2":"firis","char3":"liane","kind":"puni","hp":46,"atk":11,"defen":7,"spd":7,"level":11,"exp":9,"slash":1,"impact":1,"pierce":3,"magic":2,"fire":1,"ice":2,"light":2,"ail":2,"item_set":[{"id":"puniball-blue","name":{"en":"Puniball: Blue","ja":"プニプニ玉・青","tc":"噗尼噗尼珠‧藍","sc":"噗尼噗尼珠‧蓝"}},{"id":"puniball-green","name":{"en":"Puniball: Green","ja":"プニプニ玉・緑","tc":"噗尼噗尼珠‧綠","sc":"噗尼噗尼珠‧绿"}},{"id":"puniball-red","name":{"en":"Puniball: Red","ja":"プニプニ玉・赤","tc":"噗尼噗尼珠‧紅","sc":"噗尼噗尼珠‧红"}},{"id":"puniball-gold","name":{"en":"Puniball: Gold","ja":"プニプニ玉・金","tc":"噗尼噗尼珠‧金","sc":"噗尼噗尼珠‧金"}},{"id":"puni-fluid","name":{"en":"Puni Fluid","ja":"プニの体液","tc":"噗尼的體液","sc":"噗尼的体液"}}],"locations":[{"id":"claudel-prairie","name":{"en":"Claudel Prairie","ja":"クラーデル平原","tc":"吊鐘杯平原","sc":"吊钟杯平原"}},{"id":"southern-plains","name":{"en":"Southern Plains","ja":"南方原野","tc":"南方原野","sc":"南方原野"}},{"id":"lebenwald","name":{"en":"Lebenwald","ja":"レーベンヴァルト","tc":"生命之森","sc":"生命之森"}},{"id":"ertona-underground-lake","name":{"en":"Ertona Underground Lake","ja":"エルトナ地底湖","tc":"艾爾托納地底湖","sc":"艾尔托纳地底湖"}}],"index":73}