{"id":"cobalt-grass","name":{"en":"Cobalt Grass","ja":"コバルト草","tc":"鈷藍草","sc":"钴蓝草"},"desc1":{"en":"Oh, Blue Grass","ja":"「あ、青草だ」","tc":"「啊，是青草。」","sc":"“啊，是青草。”"},"desc2":{"en":"Don't make up names. This is Cobalt Grass. It holds a lot of moisture, so when burned, it gives off smoke. Use it for smoking food.","ja":"「変な呼び方しないの。これはコバルト草。　水気が多いから、いぶすとたくさん煙が出る　の。燻製作りなんかにも使えるわね」","tc":"「不要亂叫，這是鈷藍草。　因為富含水氣，所以能燻出很多煙來，　也可以用在燻製等等用途呢。」","sc":"“不要乱叫，这是钴蓝草。　因为富含水气，所以能熏出很多烟来，　也可以用在熏制等用途呢。”"},"char1":"firis","char2":"liane","level":3,"categories":[{"id":"plant","name":{"en":"(Plant)","ja":"（植物類）","tc":"（植物類）","sc":"（植物类）"},"icon":"firis-category-plant"},{"id":"water","name":{"en":"(Water)","ja":"（水）","tc":"（水）","sc":"（水）"},"icon":"ryza2-category-water"}],"locations":[{"id":"weist-plain","name":{"en":"Weist Plain","ja":"ウェイスト・プレイン","tc":"廢棄平原","sc":"废弃平原"}},{"id":"traveler-s-grove","name":{"en":"Traveler's Grove","ja":"旅人の雑木林","tc":"旅人的雜木林","sc":"旅人的杂木林"}},{"id":"past-paradise","name":{"en":"Past Paradise","ja":"在りし楽園","tc":"往日樂園","sc":"往日乐园"}},{"id":"outskirts-path","name":{"en":"Outskirts Path","ja":"町外れの小道","tc":"郊區的小道","sc":"郊区的小道"}},{"id":"silent-labyrinth","name":{"en":"Silent Labyrinth","ja":"深閑のラビュリント","tc":"靜寂的迷宮","sc":"静寂的迷宫"}}],"fixed_components":[{"color":"red","name":{"en":"Soft","ja":"やわらかい","tc":"軟的","sc":"软的"},"value":15}],"random_components":[{"color":"violet","name":{"en":"Purple","ja":"紫色","tc":"紫色的","sc":"紫色的"},"value":5},{"color":"green","name":{"en":"Thick","ja":"太い","tc":"粗的","sc":"粗的"},"value":20},{"color":"green","name":{"en":"Fibrous","ja":"繊維質","tc":"纖維質","sc":"纤维质"},"value":10}],"shopslot_set":[{"id":"lilie-laurier","name":{"en":"Lilie Laurier","ja":"リーリエ・ローリエ","tc":"莉莉艾‧蘿莉艾","sc":"莉莉艾‧萝莉艾"}}],"index":2}