---
import MainLayout from '@layouts/MainLayout.astro';
import type { GetStaticPathsResult } from 'astro';
import { LanguageData } from '@app/localization/localization';
import { getCollection } from 'astro:content';
import { getComponentRegistry, pageTitles } from './path-builder';
import { pathData, PathConfig } from '@app/consts';

export async function buildsectionPaths(
  configs: PathConfig[],
): Promise<GetStaticPathsResult> {
  const paths: any[] = [];
  for (const {
    game,
    section,
    fragment,
    listPath = true,
    detailPath = true,
    mainClass,
    collection,
  } of configs) {
    const collectionName = collection
      ? `${game}_${collection}`
      : `${game}_${section}`;
    const items = await getCollection(collectionName as any);
    const langs = LanguageData.languages[game];

    if (listPath) {
      (langs as string[]).forEach((lang) => {
        paths.push({
          params: { game, section: section, slug: lang },
          props: {
            mode: 'list',
            lang,
            allItems: items,
            game,
            mainClass,
            listPath,
            detailPath,
          },
        });
      });
    }

    if (detailPath) {
      (items as any[]).forEach((item) => {
        (langs as string[]).forEach((lang) => {
          paths.push({
            params: {
              game,
              section: section,
              slug: `${item.id}/${lang}`,
            },
            props: {
              mode: 'detail',
              item,
              lang,
              game,
              mainClass: 'small-page',
              listPath,
              detailPath,
            },
          });
          if (fragment) {
            paths.push({
              params: {
                game,
                section: section,
                slug: `${item.id}/fragment/${lang}`,
              },
              props: {
                mode: 'fragment',
                item,
                lang,
                game,
                listPath,
                detailPath,
              },
            });
          }
        });
      });
    }
  }
  return paths;
}

export async function getStaticPaths() {
  return buildsectionPaths(pathData);
}

const { game, section } = Astro.params;
const { mode, item, lang, allItems, mainClass, listPath, detailPath } =
  Astro.props;

const registry = await getComponentRegistry();
const ListComponent = registry[game][section].list;
const DetailComponent = registry[game][section].detail;
const title: string = listPath ? pageTitles[section][lang] : undefined;
---

{
  mode === 'list' ? (
    <MainLayout title={title} mainClass={mainClass}>
      <ListComponent
        items={allItems}
        lang={lang}
        title={title}
        game={game}
        section={section}
      />
    </MainLayout>
  ) : mode === 'detail' ? (
    <MainLayout
      title={item.data.name[lang]}
      description={
        item.data.desc
          ? item.data.desc[lang]
          : item.data.desc1
            ? item.data.desc1[lang]
            : ''
      }
      mainClass={mainClass}
    >
      <DetailComponent
        item={item.data}
        lang={lang}
        mode={mode}
        game={game}
        section={section}
      />
    </MainLayout>
  ) : (
    <DetailComponent
      item={item.data}
      lang={lang}
      mode={mode}
      game={game}
      section={section}
    />
  )
}
