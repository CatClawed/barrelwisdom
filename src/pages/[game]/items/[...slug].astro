---
import { LanguageData } from '@app/localization/localization';
import { item_translation } from '@app/localization/translations/common-strings';
import MainLayout from '@layouts/MainLayout.astro';
import { getCollection } from 'astro:content';

const gameComponents: Record<string, { list: any; detail: any }> = {
  yumia: {
    list: (await import('@components/Games/yumia/ItemList.astro')).default,
    detail: (await import('@components/Games/yumia/ItemDetail.astro')).default,
  },
};

export async function getStaticPaths() {
  const games: string[] = ['yumia'];
  const paths: any[] = [];

  for (const gameId of games) {
    const items = await getCollection(`${gameId}_items` as any);
    const langs = LanguageData.languages[gameId];

    // List pages: /yumia/items/en
    langs.forEach((lang) => {
      paths.push({
        params: { game: gameId, slug: lang },
        props: { type: 'list', lang, allItems: items },
      });
    });

    // Detail pages: /yumia/items/344/en
    items.forEach((item) => {
      const itemId = item.id;
      langs.forEach((lang) => {
        paths.push({
          params: { game: gameId, slug: `${itemId}/${lang}` },
          props: { type: 'detail', item, lang },
        });
        paths.push({
          params: { game: gameId, slug: `${itemId}/fragment/${lang}` },
          props: { type: 'fragment', item, lang },
        });
      });
    });
  }
  return paths;
}
const { game } = Astro.params;
const { type, item, lang, allItems } = Astro.props;

const ItemList = gameComponents[game].list;
const ItemDetail = gameComponents[game].detail;
---

{
  type === 'list' ? (
    <MainLayout
      title={item_translation[lang]}
      description={lang == 'en' ? 'The list of items.' : ''}
    >
      <ItemList items={allItems} lang={lang} title={item_translation[lang]} />
    </MainLayout>
  ) : type === 'detail' ? (
    <MainLayout
      title={item.data.name[lang]}
      description={
        item.data.desc ? item.data.desc[lang] : item.data.cats[0].name[lang]
      }
      image={`/media/games/${game}/items/${item.id}.webp`}
      mainClass="blog-post"
    >
      <ItemDetail item={item.data} lang={lang} card={true} />
    </MainLayout>
  ) : (
    <ItemDetail item={item.data} lang={lang} />
  )
}
