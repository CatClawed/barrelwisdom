---
import Category from '@app/components/Games/_common/Category.astro';

import { LanguageData } from '@app/localization/localization';
import { category_translation } from '@app/localization/translations/common-strings';
import MainLayout from '@layouts/MainLayout.astro';
import { getCollection } from 'astro:content';

const gameComponents: Record<string, { list?: any; detail: any }> = {
  yumia: {
    detail: (
      await import('@components/Games/yumia/categories/CategoryRow.astro')
    ).default,
  },
};

export async function getStaticPaths() {
  const games: string[] = ['yumia'];
  const paths: any[] = [];

  for (const gameId of games) {
    const items = await getCollection(`${gameId}_categories` as any);
    const langs = LanguageData.languages[gameId];

    // Detail pages: /yumia/items/344/en
    items.forEach((item) => {
      const itemId = (item as any).id;
      (langs as string[]).forEach((lang) => {
        paths.push({
          params: { game: gameId, slug: `${itemId}/${lang}` },
          props: { type: 'detail', item, lang },
        });
      });
    });
  }
  return paths;
}
const { game } = Astro.params;
const { type, item, lang } = Astro.props;

const ItemList = gameComponents[game].list;
const ItemDetail = gameComponents[game].detail;
---

<MainLayout
  title={item.data.name[lang]}
  description={category_translation[lang]}
  mainClass="medium-page"
>
  <Category name={item.data.name[lang]} using={item.data.used !== undefined}>
    <Fragment slot="inCategory">
      {item.data.in_cat.map((i) => <ItemDetail item={i} lang={lang} />)}
    </Fragment>
    {
      item.data.used && (
        <Fragment slot="usingCategory">
          {item.data.used.map((u) => (
            <ItemDetail item={u} lang={lang} />
          ))}
        </Fragment>
      )
    }
  </Category>
</MainLayout>
