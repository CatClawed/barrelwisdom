---
import { LanguageData } from '@app/localization/localization';
import { trait_translation } from '@app/localization/translations/common-strings';
import TraitDetail from '@components/Games/yumia/TraitDetail.astro';
import TraitList from '@components/Games/yumia/TraitList.astro';
import MainLayout from '@layouts/MainLayout.astro';
import { getCollection } from 'astro:content';

const allItems = await getCollection('yumia_traits');

export async function getStaticPaths() {
  const items = await getCollection('yumia_traits');
  const langs = LanguageData.languages.yumia;
  const paths: any[] = [];

  // List pages
  langs.forEach((lang) => {
    paths.push({
      params: { slug: lang },
      props: { type: 'list', lang },
    });
  });

  // Detail and fragment pages
  items.forEach((item) => {
    const itemId = item.id;
    langs.forEach((lang) => {
      paths.push({
        params: { slug: `${itemId}/${lang}` },
        props: { type: 'detail', item, lang },
      });
      paths.push({
        params: { slug: `${itemId}/fragment/${lang}` },
        props: { type: 'fragment', item, lang },
      });
    });
  });
  return paths;
}

const { type, item, lang } = Astro.props;
---

{
  type === 'list' ? (
    <MainLayout
      title={trait_translation[lang]}
      description={lang == 'en' ? 'The list of traits.' : ''}
    >
      <TraitList
        items={allItems}
        lang={lang}
        title={trait_translation[lang]}
        mode={type}
      />
    </MainLayout>
  ) : type === 'detail' ? (
    <MainLayout
      title={item.data.name[lang]}
      description={item.data.desc1[lang]}
      mainClass="blog-post"
    >
      <TraitDetail item={item.data} lang={lang} mode={type} />
    </MainLayout>
  ) : (
    <TraitDetail item={item.data} lang={lang} mode={type} />
  )
}
